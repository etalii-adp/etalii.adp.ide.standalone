<Project>

  <!-- Compiled into every test project: a source file, not a reference, so not an edge of the graph. -->
  <ItemGroup Condition="'$(MSBuildProjectName.EndsWith(`.Tests`))' == 'true'">
    <Compile Include="$(MSBuildThisFileDirectory)TestSupport\Shared.cs" Link="TestSupport\Shared.cs" />
  </ItemGroup>

  <!-- Attached to every project whose name ends in .Tests: an edge of each of them. -->
  <ItemGroup Condition="'$(MSBuildProjectName.EndsWith(`.Tests`))' == 'true'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)backend\EtAlii.Adp.TestSupport\EtAlii.Adp.TestSupport.csproj" />
    <Using Include="EtAlii.Adp.TestSupport" />
  </ItemGroup>

  <!-- A target's items are evaluated only when it runs, so they are not edges either. -->
  <Target Name="Check" Condition="'$(OS)' == 'Windows_NT'">
    <ItemGroup>
      <ProjectReference Include="Nothing.csproj" />
    </ItemGroup>
  </Target>

</Project>
