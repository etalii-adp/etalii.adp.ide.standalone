@page "/user/diagrams"
@namespace EtAlii.Adp.Client
@inject HttpClient Http
<PageTitle>Diagrams</PageTitle>

@if (_diagrams.Any() != true)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex flex-wrap">
        @foreach (var diagram in _diagrams)
        {
            <Card Class="mb-4">
                <img src="/images/placeholder.png" alt="placeholder"/>
                <CardBody>
                    <CardTitle>@diagram.Name</CardTitle>
                    <CardText>@diagram.Description</CardText>
                    <small class="text-muted">Created: @diagram.CreationDate.ToDisplayDateAndTime()</small><br/>
                    <small class="text-muted">Modified: @diagram.ModificationDate.ToDisplayDateAndTime()</small><br/>
                    <small class="text-muted">@diagram.Position</small><br/>
                    <small class="text-muted">Zoom: @diagram.Zoom</small>
                    <div style="align-self: end">
                        <Dropdown Color="DropdownColor.Light" Size="DropdownSize.Small">
                            <DropdownToggleButton><Icon Name="IconName.ThreeDots" /></DropdownToggleButton>
                            <DropdownMenu>
                                <DropdownItem To="#" Type="DropdownItemType.Link">Rename</DropdownItem>
                                <DropdownItem To="#" Type="DropdownItemType.Link">Delete</DropdownItem>
                            </DropdownMenu>
                        </Dropdown>
                    </div>
                </CardBody>
            </Card>
            <span></span>
        }
    </div>
}
