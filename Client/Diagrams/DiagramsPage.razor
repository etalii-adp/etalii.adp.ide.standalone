@page "/user/diagrams"
@namespace EtAlii.Adp.Client
<PageTitle>Diagrams</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (_diagrams == null)
        {
            <p><em>Loading...</em></p>
            <Spinner Color="SpinnerColor.Primary" />
        }
        else
        {
            <div class="d-flex flex-wrap">
                @foreach (var diagram in _diagrams)
                {
                    <DiagramCard Diagram="@diagram" Edited="@EditDiagram" Deleted="@DeleteDiagram" />
                }
                <Card Class="mb-4 editor-card">
                    <CardBody>
                        <Button
                            Class="add-button"
                            Size="ButtonSize.Large"
                            @onclick="@OnAddNewTrendDiagram"
                            Color="ButtonColor.Primary"><Icon Name="IconName.ClockHistory" /> &nbsp;Add 'Trends' diagram</Button>
                        <br/>
                        <Button
                            Disabled="@true"
                            Class="add-button"
                            Size="ButtonSize.Large"
                            @onclick="@OnAddNewTrendDiagram"
                            Color="ButtonColor.Primary"><Icon Name="IconName.Floppy" /> &nbsp;Add 'Dependencies' diagram</Button>
                        <br/>
                        <Button
                            Disabled="@true"
                            Class="add-button"
                            Size="ButtonSize.Large"
                            @onclick="@OnAddNewTrendDiagram"
                            Color="ButtonColor.Primary"><Icon Name="IconName.Watch" /> &nbsp;Add 'Timeline' diagram</Button>
                    </CardBody>
                </Card>
                <span></span>

            </div>
        }
    </Authorized>
    <NotAuthorized>
        <h3 style="text-align: center; margin-top: 50px"><i><b>You are not authorized</b> - "Either log in or go away."</i></h3>
    </NotAuthorized>
</AuthorizeView>

