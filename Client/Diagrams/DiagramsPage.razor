@page "/user/diagrams"
@namespace EtAlii.Adp.Client
@inject HttpClient Http
<PageTitle>Diagrams</PageTitle>

@if (_diagrams.Any() != true)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="d-flex flex-wrap">
        @foreach (var diagram in _diagrams)
        {
            <Card Class="mb-4">
                <img src="/images/placeholder.png" alt="placeholder"/>
                <CardBody>
                    <CardTitle>@diagram.Date</CardTitle>
                    <CardText>@diagram.Summary</CardText>
                    <CardText Class="text-muted">@diagram.TemperatureC</CardText>
                </CardBody>
            </Card>
            <span></span>
        }
    </div>
}
