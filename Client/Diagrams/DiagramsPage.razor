@page "/user/diagrams"
@namespace EtAlii.Adp.Client
<PageTitle>Ubigia - Diagrams</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (_diagrams == null)
        {
            <LoadingMessage Message="Loading diagrams" />
        }
        else
        {
            <div class="d-flex flex-wrap">
                @foreach (var diagram in _diagrams)
                {
                    <DiagramCard 
                        Diagram="@diagram" 
                        Edited="@EditedDiagram" 
                        Deleted="@DeleteDiagram" 
                        View="@ViewDiagram" />
                }
                <Card Class="mb-4 editor-card">
                    <CardBody>
                        <Button
                            Class="add-button"
                            Size="ButtonSize.Large"
                            @onclick="@OnAddNewTrendDiagram"
                            Color="ButtonColor.Primary"><Icon Name="IconName.ClockHistory" /> &nbsp;Add 'Trend' perspective</Button>
                        <br/>
                        <Button
                            Disabled="@true"
                            Class="add-button"
                            Size="ButtonSize.Large"
                            @onclick="@OnAddNewTrendDiagram"
                            Color="ButtonColor.Primary"><Icon Name="IconName.Floppy" /> &nbsp;Add 'Dependency' perspective</Button>
                        <br/>
                        <Button
                            Disabled="@true"
                            Class="add-button"
                            Size="ButtonSize.Large"
                            @onclick="@OnAddNewTrendDiagram"
                            Color="ButtonColor.Primary"><Icon Name="IconName.Watch" /> &nbsp;Add 'Timeline' perspective</Button>
                    </CardBody>
                </Card>
                <span></span>

            </div>
        }
    </Authorized>
    <NotAuthorized>
        <NotAuthorizedContent />
    </NotAuthorized>
</AuthorizeView>

