@namespace EtAlii.Adp.Client

<Card Class="mb-4">
    <CardBody>
        @if (!_isEditingName)
        {
            <CardTitle @onclick="OnStartNameEdit" >@_diagramName</CardTitle>
        }
        else
        {
            <TextInput @ref="_nameInput" class="node-text-input" @onblur="OnEndNameEdit" @bind-Value="@_diagramName" />
        }
        @if (!_isEditingDescription)
        {
            <CardText @onclick="OnStartDescriptionEdit" >@_diagramDescription</CardText>
        }
        else
        {
            <TextInput @ref="_descriptionInput" class="node-text-input" @onblur="OnEndDescriptionEdit" @bind-Value="@_diagramDescription" />
        }
        <small class="text-muted">Created: @Diagram.CreationDate.ToDisplayDateAndTime()</small><br/>
        <small class="text-muted">Modified: @Diagram.ModificationDate.ToDisplayDateAndTime()</small><br/>
        <small class="text-muted">Position: @Diagram.Position.X.ToString("0.#####"), @Diagram.Position.Y.ToString("##.#####")</small><br/>
        <small class="text-muted">Zoom: @Diagram.Zoom.ToString("0.#####")</small>
        @if (!_isEditingName && !_isEditingDescription)
        {
            <div style="position: absolute; top: 0; right: 0; margin-right: 5px; margin-top: 5px">
                <Button Size="ButtonSize.Small" Color="ButtonColor.Light" @onclick="@(() => ViewDiagram(Diagram))"><Icon Name="IconName.Eye"/></Button>
            </div>
            <div style="position: absolute; bottom: 0; right: 0; margin-right: 5px; margin-bottom: 5px">
                <Dropdown Color="DropdownColor.Light" Size="DropdownSize.Small">
                    <DropdownToggleButton><Icon Name="IconName.ThreeDots"/></DropdownToggleButton>
                    <DropdownMenu>
                        <DropdownItem To="#" @onclick="@(() => EditDiagram(Diagram))">Rename</DropdownItem>
                        <DropdownItem To="#" @onclick="@(() => DeleteDiagram(Diagram))">Delete</DropdownItem>
                    </DropdownMenu>
                </Dropdown>
            </div>
        }
    </CardBody>
</Card>
<span></span>
