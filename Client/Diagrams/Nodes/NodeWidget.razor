@using Blazor.Diagrams.Components.Renderers
@namespace EtAlii.Adp.Client

<div @ondblclick="OnStartNameEdit" class="default-node @(Node.Group != null ? "grouped" : "") @(Node.Selected ? "selected" : "")">
    @if (!_isEditing)
    {
        <h5>@_nodeName</h5>
    }
    else
    {
        <TextInput class="node-text-input" @onblur="OnEndNameEdit" @bind-Value="@_nodeName" />
    }
    
    @foreach (var port in Node.Ports)
    {
        <PortRenderer @key="port" Port="port" Class="default" />
    }
</div>