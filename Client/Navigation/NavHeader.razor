@namespace EtAlii.Adp.Client

<div class="top-row d-flex px-4">
        @if (_lastDiagram != null)
        {
            <div class="flex-grow-1">
                @_ubigiaLink
                @_userLink
                @_diagramsLink
                @_diagramLink
            </div>
        }
        else if (_userName != null)
        {
            <div class="flex-grow-1">
                @_ubigiaLink
                @_userLink
                @_diagramsLink
            </div>
        }
        else
        {
            <div class="flex-grow-1">
                @_ubigiaLink
            </div>
        }
        <div class="ms-3">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>
    <div class="ms-3">
    <AuthorizeView>
        <Authorized>
            @if (LocalDebugger.IsAttached)
            {
                <a href="/.auth/logout/local" @onclick="@LogoutLocalDeveloper" @onclick:preventDefault>Logout</a>
            }
            else
            {
                <a href="/.auth/logout">Logout</a>
            }
        </Authorized>
        <NotAuthorized>
            <Dropdown Color="DropdownColor.None">
                <DropdownToggleButton>Login</DropdownToggleButton>
                <DropdownMenu>
                    <ul class="list-group list-group-flush">
                        @* @foreach(var provider in AuthenticationProviders) *@
                        @* { *@
                        @*     <li class="list-group-item"> *@
                        @*         <a class="btn btn-block btn-lg btn-social btn-@provider.Key" href="/.auth/login/@provider.Key"> *@
                        @*             <span class="fa fa-@provider.Key"></span> Sign in with @provider.Value *@
                        @*         </a> *@
                        @*     </li> *@
                        @* } *@
                        <li class="list-group-item">
                            <a href="/.auth/login/github??post_login_redirect_uri=@(_landingUrlAfterLogin)">Login using GitHub</a>
                        </li>
                        <li class="list-group-item">
                            <a href="/.auth/login/github??post_login_redirect_uri=@(_landingUrlAfterLogin)">Login using Microsoft</a>
                        </li>
                        @if (LocalDebugger.IsAttached)
                        {
                            <li class="list-group-item">
                                <a href="/.auth/login/local" @onclick="@LoginLocalDeveloper" @onclick:preventDefault>Login as Developer</a>
                            </li>
                        }
                    </ul>

                    @* <CardTitle>Card title</CardTitle> *@
                    @* <CardText>Some quick example text to build on the card title and make up the bulk of the card's content.</CardText> *@
                    @* <Button Color="ButtonColor.Primary" To="#" Type="ButtonType.Link">Go somewhere</Button> *@

                    @* <DropdownItem To="#" Type="DropdownItemType.Link">Action</DropdownItem> *@
                    @* <DropdownItem To="#" Type="DropdownItemType.Link">Another action</DropdownItem> *@
                    @* <DropdownItem To="#" Type="DropdownItemType.Link">Something else here</DropdownItem> *@
                </DropdownMenu>
            </Dropdown>

            
        </NotAuthorized>
    </AuthorizeView>
    </div>
</div>