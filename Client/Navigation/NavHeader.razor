@namespace EtAlii.Adp.Client

<div class="top-row d-flex px-4" style="margin-top: 8px; margin-bottom: 8px;">
        @if (_selectedPage == SelectedPage.Diagram)
        {
            <div class="flex-grow-1">
                @_ubigiaLink
                @_adpLink
                @_userLink
                @_diagramsLink
                @_diagramLink
            </div>
        }
        else if (_userName != null)
        {
            <div class="flex-grow-1">
                @_ubigiaLink
                @_adpLink
                @_userLink
                @_diagramsLink
            </div>
        }
        else
        {
            <div class="flex-grow-1">
                @_ubigiaLink
                @_adpLink
            </div>
        }
        <div class="ms-3">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div>
    <div class="ms-3">
    <AuthorizeView>
        <Authorized>
            @if (LocalDebugger.IsAttached)
            {
                <a href="/.auth/logout/local" @onclick="@LogoutLocalTestUser" @onclick:preventDefault>Logout</a>
            }
            else
            {
                <a href="/.auth/logout">Logout</a>
            }
        </Authorized>
        <NotAuthorized>
            <Modal
                @ref="_loginModal"
                title=""
                ShowCloseButton="false"
                IsVerticallyCentered="true">
                <BodyTemplate>
                    <ul class="list-group list-group-flush">
                        <Button Class="login-github-btn" @onclick="@LoginUsingGitHub">
                            <Icon Name="IconName.Github"/> Sign in with GitHub
                        </Button>
                        <Button Class="login-microsoft-btn" @onclick="@LoginUsingMicrosoft">
                            <Icon Name="IconName.Microsoft"/> Sign in with Microsoft
                        </Button>
                        @if (LocalDebugger.IsAttached)
                        {
                            @foreach (var user in User.LocalTestUsers)
                            {
                                <Button Class="login-test-user-btn" @onclick="@(() => LoginLocalTestUser(user))">
                                    <Icon Name="IconName.Person"/> Sign in as @user.Name
                                </Button>
                            }
                        }
                    </ul>
                </BodyTemplate>
            </Modal>

            <a href="/.auth/login" @onclick="@ShowLoginModal" @onclick:preventDefault>Login</a>
        </NotAuthorized>
    </AuthorizeView>
        @if (LocalDebugger.IsAttached)
        {
            <b style="color: red">&nbsp;&nbsp;DEBUG</b>
        }
    </div>
</div>