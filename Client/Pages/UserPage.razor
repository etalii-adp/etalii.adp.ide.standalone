@page "/user"
<PageTitle>Ubigia</PageTitle>
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization

<h2>Identity</h2>

Name: @_authenticatedUser?.Identity?.Name - @_authenticatedUser?.Identity?.AuthenticationType - @_authenticatedUser?.Identity?.IsAuthenticated<br/>

<h2>Identities</h2>

@foreach (var identity in _authenticatedUser?.Identities ?? [])
{
    <p class="identity">@(identity.Name): @identity.Label - @identity.AuthenticationType - @identity.IsAuthenticated</p>
}

<h2>Claims</h2>

@foreach (var claim in _authenticatedUser?.Claims ?? [])
{
    <p class="claim">@(claim.Type): @claim.Value</p>
}