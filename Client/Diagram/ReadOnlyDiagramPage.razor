@namespace EtAlii.Adp.Client
@inherits DiagramPageBase
@page "/diagram/{DiagramId:guid}"
<PageTitle>Ubigia - @(CurrentDiagram?.Name ?? "Diagram")</PageTitle>

<DiagramRibbon @ref="Ribbon"/>
@if (IsLoaded)
{
    <div class="@(CurrentDiagram!.IsReadOnly ? "diagram-container-no-ribbon" : "diagram-container")">
        <CascadingValue Value="DiagramView">
            <CascadingValue Value="Context">
                <DiagramComponent />
            </CascadingValue>
        </CascadingValue>
    </div>
    <Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight"/>    
}
else
{
    <div style="display: flex; margin: 100px; justify-content: center;">
        <Spinner Color="SpinnerColor.Primary" />   
    </div>
}
