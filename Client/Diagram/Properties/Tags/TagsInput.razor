@namespace EtAlii.Adp.Client

<div class="tag-input" disabled="@Disabled">
    <div class="tags">
        @foreach (var tag in _selectedTags)
        {
            <DeletableTagView Tag="@tag" Delete="UnassignTag" />
        }
    </div>
    @if (_canAdd)
    {
        <Dropdown @ref="_tagOptionsDropDown" 
                  AutoClose="true" 
                  AutoCloseBehavior="DropdownAutoCloseBehavior.Inside" >
            <input @bind-value="_newTagName"
                   @bind-value:event="oninput"
                   @onkeyup="HandleKeyPress" placeholder="Add a tag..." 
                   @onfocus="OnInputFieldGotFocus" @onblur="OnInputFieldLostFocus" />
            <DropdownMenu Style="width:300px;">
                <div class="tags">
                    @foreach (var tag in _visibleAvailableTags)
                    {
                        <AssignableTagView Tag="@tag" Assign="AssignExistingTag" />
                    }
                </div>
            </DropdownMenu>
        </Dropdown>
    }
</div>