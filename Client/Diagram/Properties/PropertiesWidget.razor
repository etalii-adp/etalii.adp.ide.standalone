@namespace EtAlii.Adp.Client

<Card style="@Style">
    <CardHeader>Properties</CardHeader>

    <div class="container">
        <div class="row">
            @foreach (var property in Properties)
            {
                <div class="col-md-6">@property.Key</div>
                <div class="col-md-6">
                    @* @if (property.ValueType == typeof(string)) *@
                    @* {                     *@
                    @*     <TextInput @bind-Value="@_text" /> *@
                    @*     $1$ <input type="text" class="form-control" @bind="@property.Value" /> #1# *@
                    @* } *@
                    @* else if (property.ValueType == typeof(int) || property.ValueType == typeof(double)) *@
                    @* { *@
                    @*     $1$ <NumberInput TValue="int" Value="234" /> #1# *@
                    @*     $1$ <input type="number" class="form-control" @bind="@property.Value" /> #1# *@
                    @* } *@
                    @* else if (property.ValueType == typeof(bool)) *@
                    @* { *@
                    @*     $1$ <CheckboxInput Value="true" /> #1# *@
                    @*     $1$ <input type="checkbox" class="form-check-input" @bind="@property.Value" /> #1# *@
                    @* } *@
                    @* else if (property.ValueType == typeof(DateTime)) *@
                    @* { *@
                    @*     <DateInput TValue="DateOnly" @bind-value="@_date" /> *@
                    @* } *@
                </div>
            }
        </div>
    </div>


</Card>
