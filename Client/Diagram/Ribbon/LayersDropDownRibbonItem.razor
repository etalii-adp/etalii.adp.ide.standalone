@namespace EtAlii.Adp.Client
@inherits DropDownRibbonItem<LayersCommandHandler>

<RibbonItem
    Style="@ButtonStyle"
    Class="@ButtonClass"
    IconColor="@IconColor"
    IconSize="IconSize.x3"
    @ref="RibbonItem" 
    Name="@ButtonName" 
    IconName="@IconName">@IconTitle</RibbonItem>

<Card @ref="DropDownCard" Style="@DropDownCardStyle">
    <CardBody>
        @foreach (var layerTag in _layerTags)
        {
            <CheckboxInput Label="@layerTag.Name" @bind-Value="_checkedValue" />
        }
    </CardBody>
</Card>
