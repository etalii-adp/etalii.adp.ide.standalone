@namespace EtAlii.Adp.Client

<style>
    .disabled-ribbon-button {
        pointer-events: none; /* Prevent clicks, hovers, etc. */
        opacity: 0.5; /* Make it look disabled */
        user-select: none;
    }
</style>

<div class="editor-ribbon"></div>
<Ribbon OnClick="OnRibbonItemClick" Style="margin-top: -18px; margin-left: 10px;">
    <RibbonTab Title="Home" Active="true">
        <Content>
            <!-- New -->
            <RibbonItemGroup Name="New">
                <DiagramRibbonPlaceStub Name="NewEmail" IconName="IconName.EnvelopePlus">New<br/>Email</DiagramRibbonPlaceStub>
                <DiagramRibbonPlaceStub Name="Appointment" IconName="IconName.Calendar3Event"/>
                <DiagramRibbonItem Context="@_context" THandler="StartNodeRenameCommandHandler"/>
            </RibbonItemGroup>
            <RibbonItemGroup Name="Delete">
                <DiagramRibbonItem Context="@_context" THandler="DeleteCommandHandler"/>
                <DiagramRibbonPlaceStub Name="Archive" IconName="IconName.Archive">Archive<br/>&nbsp;</DiagramRibbonPlaceStub>
            </RibbonItemGroup>
            <RibbonItemGroup Name="Undo / Redo">
                <DiagramRibbonItem Context="@_context" THandler="UndoCommandHandler"/>
                <DiagramRibbonItem Context="@_context" THandler="RedoCommandHandler"/>
            </RibbonItemGroup>
            <RibbonItemGroup Name="Grouping">
                <DiagramRibbonItem Context="@_context" THandler="GroupNodesCommandHandler"/>
                <DiagramRibbonItem Context="@_context" THandler="UngroupNodesCommandHandler"/>
            </RibbonItemGroup>
            <RibbonItemGroup Name="Alignment">
                <DiagramRibbonItem Context="@_context" THandler="AlignNodesTopCommandHandler"/>
                <DiagramRibbonItem Context="@_context" THandler="AlignNodesBottomCommandHandler"/>
                <DiagramRibbonItem Context="@_context" THandler="AlignNodesLeftCommandHandler"/>
                <DiagramRibbonItem Context="@_context" THandler="AlignNodesRightCommandHandler"/>
            </RibbonItemGroup>
        </Content>
    </RibbonTab>
    <RibbonTab Title="View">
        <Content>
            <RibbonItemGroup Name="Selection">
                <DiagramRibbonPlaceStub Name="Fit all" IconName="IconName.ArrowsFullscreen">Fit all<br/>&nbsp;</DiagramRibbonPlaceStub>
                <DiagramRibbonPlaceStub Name="Fit selection" IconName="IconName.AspectRatio">Fit<br/>selection</DiagramRibbonPlaceStub>
            </RibbonItemGroup>
            <RibbonItemGroup Name="View">
                <DiagramRibbonItem Context="@_context" THandler="ToggleShowNavigationCommandHandler"/>
                <DiagramRibbonItem Context="@_context" THandler="ToggleShowPropertiesCommandHandler"/>
                <DiagramRibbonItem Context="@_context" THandler="ToggleFullscreenCommandHandler"/>
            </RibbonItemGroup>
            <RibbonItemGroup Name="Data">
                <DiagramRibbonPlaceStub Name="Layers" IconName="IconName.Layers">Filter by<br/>layers</DiagramRibbonPlaceStub>
                <DiagramRibbonPlaceStub Name="Tags" IconName="IconName.Tags">Filter by<br/>tags</DiagramRibbonPlaceStub>
            </RibbonItemGroup>
        </Content>
    </RibbonTab>
    <RibbonTab Title="Structure">
        <Content>
            <RibbonItemGroup Name="Tags">
                <DiagramRibbonPlaceStub Name="SendReceiveAllFolders" IconName="IconName.EnvelopePlus" >Send/Receive<br/>All Folders</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="UpdateFolder" IconName="IconName.Calendar3Event" >Update<br/>Folder</DiagramRibbonPlaceStub> 
            </RibbonItemGroup>
            <!-- Download -->
            <RibbonItemGroup Name="Download">
                <DiagramRibbonPlaceStub Name="ShowProgress" IconName="IconName.Trash" >Show<br/>Progress</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="CancelAll" IconName="IconName.XSquareFill" >Cancel<br/>All</DiagramRibbonPlaceStub> 
            </RibbonItemGroup>
        </Content>
    </RibbonTab>
    <RibbonTab Title="Folder">
        <Content>
            <!-- New -->
            <RibbonItemGroup Name="New">
                <DiagramRibbonPlaceStub Name="NewFolder" IconName="IconName.FolderPlus">New<br/>Folder</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="NewSearchFolder" IconName="IconName.Search">New<br/>Search Folder</DiagramRibbonPlaceStub> 
            </RibbonItemGroup>
            <!-- Actions -->
            <RibbonItemGroup Name="Actions">
                <DiagramRibbonPlaceStub Name="RenameFolder" IconName="IconName.CursorText">Rename<br/>Folder</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="CopyFolder" IconName="IconName.Copy">Copy<br/>Folder</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="MoveFolder" IconName="IconName.ArrowRight">Move<br/>Folder</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="DeleteFolder" IconName="IconName.FolderX">Delete<br/>Folder</DiagramRibbonPlaceStub> 
            </RibbonItemGroup>
        </Content>
    </RibbonTab>
    <RibbonTab Title="Import / Export">
        <Content>
            <RibbonItemGroup Name="Export">
                <DiagramRibbonPlaceStub Name="ExportLlm" IconName="IconName.Chat" >Export to<br/>LLM</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="ExportJson" IconName="IconName.FileTypeJson" >Export as<br/>JSON</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="ExportXml" IconName="IconName.FileTypeXml" >Export as<br/>XML</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="ExportImage" IconName="IconName.Image" >Export as<br/>Image</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="ExportAzure" IconName="IconName.Microsoft" >Export to<br/>Azure DevOps</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="ExportGitHub" IconName="IconName.Github" >Export to<br/>Github Project</DiagramRibbonPlaceStub> 
            </RibbonItemGroup>
            <RibbonItemGroup Name="Import">
                <DiagramRibbonPlaceStub Name="ImportAzure" IconName="IconName.Microsoft" >Import from <br/>Azure DevOps</DiagramRibbonPlaceStub> 
                <DiagramRibbonPlaceStub Name="ImportGitHub" IconName="IconName.Github" >Import from<br/>Github Project</DiagramRibbonPlaceStub> 
            </RibbonItemGroup>
        </Content>
    </RibbonTab>
    <RibbonTab Title="Synchronize">
        <Content>
            <DiagramRibbonPlaceStub Name="SynchronizeAzure" IconName="IconName.Microsoft" >Sync <br/>Azure DevOps</DiagramRibbonPlaceStub> 
            <DiagramRibbonPlaceStub Name="SynchronizeGithub" IconName="IconName.Github" >Sync <br/>Github Project</DiagramRibbonPlaceStub> 
            <DiagramRibbonPlaceStub Name="SynchronizeNotion" IconName="IconName.SquareHalf" >Sync <br/>Notion</DiagramRibbonPlaceStub> 
        </Content>
    </RibbonTab>
</Ribbon>
