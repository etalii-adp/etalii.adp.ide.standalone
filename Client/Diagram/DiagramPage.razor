@namespace EtAlii.Adp.Client
@page "/user/diagrams/{DiagramTitle}"
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
<PageTitle>Ubigia - @_currentDiagram.Name</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (!_currentDiagram.IsReadOnly)
        {
            <DiagramRibbon @ref="_ribbon"/>
        }

        <div class="diagram-container">
            <CascadingValue Value="DiagramView">
                <CascadingValue Value="_context">
                    <DiagramCanvas>
                        <Widgets>
                            @if (_currentDiagram is { ShowProperties: true, IsReadOnly: false })
                            {
                                <PropertiesWidget
                                    Style="position: absolute; left: 15px; top: 15px; bottom: 15px; border: 1px solid black; width: 400px; border-radius: 0">
                                </PropertiesWidget>
                            }
                            @if (_currentDiagram is { ShowNavigation: true, IsReadOnly: false })
                            {
                                <NavigatorWidget
                                    Width="200"
                                    Height="150"
                                    Style="position: absolute; bottom: 15px; right: 15px; border: 1px solid black;">
                                </NavigatorWidget>
                            }
                            <SelectionBoxWidget/>
                        </Widgets>
                    </DiagramCanvas>
                </CascadingValue>
            </CascadingValue>
        </div>
        <Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight"/>
    </Authorized>
    
    <NotAuthorized>
        <NotAuthorizedContent />
    </NotAuthorized>
</AuthorizeView>
