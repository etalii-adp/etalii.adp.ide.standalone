@namespace EtAlii.Adp.Client
@page "/user/diagrams/{DiagramTitle}"
@using Blazor.Diagrams.Components
@using Blazor.Diagrams.Components.Widgets
<PageTitle>Ubigia - @_currentDiagram.Name</PageTitle>

<AuthorizeView>
    <Authorized>
        <DiagramRibbon @ref="_ribbon" />

        <div class="diagram-container">
            <CascadingValue Value="DiagramView">
                <DiagramCanvas>
                    <Widgets>
                        @if (DiagramView.ShowProperties)
                        {
                            <PropertiesWidget
                                Style="position: absolute; left: 15px; top: 15px; bottom: 15px; border: 1px solid black; width: 400px; border-radius: 0">
                            </PropertiesWidget>
                        }
                        <NavigatorWidget
                            Width="200"
                            Height="150"
                            Style="position: absolute; bottom: 15px; right: 15px; border: 1px solid black;">
                        </NavigatorWidget>
                        <SelectionBoxWidget/>
                    </Widgets>
                </DiagramCanvas>
            </CascadingValue>
        </div>
    </Authorized>
    
    <NotAuthorized>
        <NotAuthorizedContent />
    </NotAuthorized>
</AuthorizeView>
