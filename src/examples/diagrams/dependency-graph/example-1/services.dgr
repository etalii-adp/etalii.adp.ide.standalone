dependencies: 1
# What the storefront needs to serve a checkout, read left to right: each arrow points at the
# thing being depended upon. Rows carry no meaning beyond keeping related services together.
elements:
  - id: checkout-web
    label: Checkout web
    x: 65.20506675795959
    row: 4
  - id: api-gateway
    label: API gateway
    x: 336.6432239448329
    row: 4
  - id: identity-service
    label: Identity service
    x: 832.052819484521
    row: 4
  - id: order-service
    label: Order service
    x: 582.8763143737467
    row: 2
  - id: notification-service
    label: Notification service
    x: 829.724067100308
    row: 6
  - id: payment-service
    label: Payment service
    x: 908.2869858658972
    row: -1
  - id: inventory-service
    label: Inventory service
    x: 1011.9164669633687
    row: 1
  - id: payments-db
    label: Payments database
    x: 1167.3282144079815
    row: -1
  - id: orders-db
    label: Orders database
    x: 1249.9989240475375
    row: 2
  - id: message-broker
    label: RabbitMQ broker
    x: 1114.9312857631926
    row: 4
relations:
  - id: r-web-gateway
    from: checkout-web
    to: api-gateway
    label: calls
  - id: r-gateway-identity
    from: api-gateway
    to: identity-service
    label: verifies tokens with
  - id: r-gateway-orders
    from: api-gateway
    to: order-service
    label: routes to
  - id: r-orders-identity
    from: order-service
    to: identity-service
  - id: r-orders-payment
    from: order-service
    to: payment-service
    label: authorises through
  - id: r-orders-inventory
    from: order-service
    to: inventory-service
    label: reserves through
  - id: r-orders-db
    from: order-service
    to: orders-db
  - id: r-orders-broker
    from: order-service
    to: message-broker
    label: publishes to
  - id: r-payment-db
    from: payment-service
    to: payments-db
  - id: r-inventory-db
    from: inventory-service
    to: orders-db
  - id: r-notify-broker
    from: notification-service
    to: message-broker
    label: consumes from
