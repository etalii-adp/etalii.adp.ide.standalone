dependencies: 1
# What the storefront needs to serve a checkout, read left to right: each arrow points at the
# thing being depended upon. Rows carry no meaning beyond keeping related services together.
elements:
  - id: checkout-web
    label: Checkout web
    x: 0
    row: 2
  - id: api-gateway
    label: API gateway
    x: 240
    row: 2
  - id: identity-service
    label: Identity service
    x: 520
    row: 0
  - id: order-service
    label: Order service
    x: 520
    row: 2
  - id: notification-service
    label: Notification service
    x: 520
    row: 5
  - id: payment-service
    label: Payment service
    x: 800
    row: 1
  - id: inventory-service
    label: Inventory service
    x: 800
    row: 3
  - id: payments-db
    label: Payments database
    x: 1080
    row: 0
  - id: orders-db
    label: Orders database
    x: 1080
    row: 2
  - id: message-broker
    label: RabbitMQ broker
    x: 1080
    row: 5
relations:
  - id: r-web-gateway
    from: checkout-web
    to: api-gateway
    label: calls
  - id: r-gateway-identity
    from: api-gateway
    to: identity-service
    label: verifies tokens with
  - id: r-gateway-orders
    from: api-gateway
    to: order-service
    label: routes to
  - id: r-orders-identity
    from: order-service
    to: identity-service
  - id: r-orders-payment
    from: order-service
    to: payment-service
    label: authorises through
  - id: r-orders-inventory
    from: order-service
    to: inventory-service
    label: reserves through
  - id: r-orders-db
    from: order-service
    to: orders-db
  - id: r-orders-broker
    from: order-service
    to: message-broker
    label: publishes to
  - id: r-payment-db
    from: payment-service
    to: payments-db
  - id: r-inventory-db
    from: inventory-service
    to: orders-db
  - id: r-notify-broker
    from: notification-service
    to: message-broker
    label: consumes from
