<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The diagram abstractions every module needs, and nothing a host needs (code-structure FR-054;
    SC-012): the documents project and the shared primitives, no other core project, and no web or
    gRPC hosting package. The bases that need more are EtAlii.Adp.Diagram.Modules'; the services a
    connection calls, and the wire they serve, are EtAlii.Adp.Workspace's.
  -->

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Both serve DiagramDefinitionDiscovery only. Serilog rather than a host logging
      abstraction, so this library stays host-agnostic and logs through the same static
      pipeline everywhere; DependencyModel to read the deployment manifest the assembly walk
      is seeded from.
    -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
  </ItemGroup>

</Project>
