<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp.Specification.Fbl\EtAlii.Adp.Specification.Fbl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- An FBL document embedded as a module embeds its binding, for BundledBindingTests. -->
    <EmbeddedResource Include="Conformance\timeline.fbl" LogicalName="timeline.fbl" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test support of the areas these tests use; see src/Directory.Build.targets. -->
    <ProjectReference Include="..\EtAlii.Adp.Diagram.Tests.Support\EtAlii.Adp.Diagram.Tests.Support.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Specification.Fbl.Tests.Support\EtAlii.Adp.Specification.Fbl.Tests.Support.csproj" />
    <Using Include="EtAlii.Adp.Diagram.Tests.Support" />
    <Using Include="EtAlii.Adp.Specification.Fbl.Tests.Support" />
  </ItemGroup>

</Project>
