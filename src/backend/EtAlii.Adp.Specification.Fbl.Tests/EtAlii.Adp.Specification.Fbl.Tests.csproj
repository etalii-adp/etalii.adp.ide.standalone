<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp.Specification.Fbl\EtAlii.Adp.Specification.Fbl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The module cross-check's shared part, which the test projects of the modules it reads compile from here, so that
      this project references no tool module (code-structure T287). It holds no test of its own.
    -->
    <Compile Remove="RealFiles\ModuleCrossCheck.cs" />
    <!-- An FBL document embedded as a module embeds its binding, for BundledBindingTests. -->
    <EmbeddedResource Include="Conformance\timeline.fbl" LogicalName="timeline.fbl" />
  </ItemGroup>

</Project>
