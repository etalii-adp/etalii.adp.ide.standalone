<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Serves ToolDefinitionScan only: the shared module-discovery scan logs through the
         same static Serilog pipeline everything else uses. -->
    <PackageReference Include="Microsoft.Extensions.DependencyModel" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <!-- ToolDefinitionScan is internal: the three definition families consume it, and nobody
         else grows a dependency on the scan's shape. -->
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram" />
    <InternalsVisibleTo Include="EtAlii.Adp.Editor" />
    <InternalsVisibleTo Include="EtAlii.Adp.Designer" />
  </ItemGroup>

</Project>
