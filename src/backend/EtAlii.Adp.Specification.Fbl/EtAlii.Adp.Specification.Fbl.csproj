<Project Sdk="Microsoft.NET.Sdk">

  <!-- FBL 0.1, the Format Binding Language of etalii-adp/etalii.adp, as a library that takes bytes and
       returns bytes. It references no project of this solution on purpose (fbl-implementation
       Requirement 1.3): what it proves about FBL must not be borrowed from this host's own document
       primitives. YamlDotNet is used only to decide whether a yaml body is well-formed. -->

  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Specification.Fbl.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
    <!-- The CEL engine of FBL section 2.4, shared with DISL; FBL's contexts are presets of it, in Expressions/. -->
    <ProjectReference Include="..\EtAlii.Adp.Specification.Cel\EtAlii.Adp.Specification.Cel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Files\" />
  </ItemGroup>

</Project>
