<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The gRPC API alone - the service bases, ServerCallContext, RpcException - and not the
         ASP.NET Core server, which only the host project carries, so that no tool module reaches a
         hosting package (code-structure FR-054, FR-065). -->
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
    <ProjectReference Include="..\EtAlii.Adp.Sessions\EtAlii.Adp.Sessions.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The projects wire contract, owned here since the area extraction: the proto stays
         at the repository root and generates into EtAlii.Adp.Projects.Wire. -->
    <Protobuf Include="..\..\api\projects.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\projects.proto" />
  </ItemGroup>

</Project>
