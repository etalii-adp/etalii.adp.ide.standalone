<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The host-facing residue of the decomposition: after eleven tasks shed every
    functional area, backlog item 9 folded the client hosting in under Client/ -
    serving the built client app and proxying to the Vite dev server in development,
    hosting-facing code that takes the ASP.NET Core frame and depends on no
    functional project. It owns no generated types - a new .proto is deliberately
    added to the project that should own it, never picked up by a glob; the
    default-include glob that used to live here was removed with its last exclusion,
    because an exclude list is a rule that must be remembered and an absent item is
    a rule that cannot be forgotten.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Serilog" />
    <ProjectReference Include="..\EtAlii.Adp.Common\EtAlii.Adp.Common.csproj" />
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
  </ItemGroup>

</Project>
