<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
    <PackageReference Include="Serilog" />
    <ProjectReference Include="..\EtAlii.Adp.Common\EtAlii.Adp.Common.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Authentication\EtAlii.Adp.Authentication.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Projects\EtAlii.Adp.Projects.csproj" />
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
    <!-- Core -> abstraction only: the Add action reads DiagramDefinition.All; no module is referenced. -->
    <ProjectReference Include="..\EtAlii.Adp.Editor\EtAlii.Adp.Editor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GrpcServices="Both": this project is the single owner of the generated
      message/service types (server base classes it implements, plus client
      stubs). EtAlii.Adp.Backend.Tests references this project rather than
      independently including these .proto files itself, to avoid duplicate
      generated types across assemblies; its integration tests use the
      client stubs generated here to call the services in-process.
    -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="Both"
              Exclude="..\..\api\shared.proto;..\..\api\connection.proto;..\..\api\elements.proto;..\..\api\diagrams.proto;..\..\api\deltas.proto;..\..\api\projects.proto;..\..\api\authentication.proto" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Hierarchy\Commands\" />
  </ItemGroup>
  <ItemGroup>
    <!-- EditorResolver's logger-injecting constructor is internal: only the tests need it,
         to keep the once-at-Error contract assertable without the shared static pipeline. -->
    <InternalsVisibleTo Include="EtAlii.Adp.Backend.Tests" />
  </ItemGroup>

</Project>
