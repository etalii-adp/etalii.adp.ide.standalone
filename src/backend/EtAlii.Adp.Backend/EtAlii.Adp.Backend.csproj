<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Web" />
  </ItemGroup>

  <ItemGroup>
    <!--
      GrpcServices="Both": this project is the single owner of the generated
      message/service types (server base classes it implements, plus client
      stubs). EtAlii.Adp.Backend.Tests references this project rather than
      independently including these .proto files itself, to avoid duplicate
      generated types across assemblies; its integration tests use the
      client stubs generated here to call the services in-process.
    -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="Both" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
  </ItemGroup>

</Project>
