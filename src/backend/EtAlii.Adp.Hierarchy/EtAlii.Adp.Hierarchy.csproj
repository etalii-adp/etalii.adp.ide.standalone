<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
    <ProjectReference Include="..\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Projects\EtAlii.Adp.Projects.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Editor\EtAlii.Adp.Editor.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Designer\EtAlii.Adp.Designer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hierarchy wire contract, owned here since the area extraction. -->
    <Protobuf Include="..\..\api\hierarchy.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\hierarchy.proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- The hierarchy unit tests reach internals (DiagramFilePair, EditorResolver and
         friends) - the moved-internals pattern from the Sessions extraction. They now live
         in EtAlii.Adp.Hierarchy.Tests (post-decomposition backlog item 2); the
         EtAlii.Adp.Backend.Tests grant remains for the AdpFileWriter/LineDocument/LineSplice
         tests still there and any other consumer. -->
    <InternalsVisibleTo Include="EtAlii.Adp.Hierarchy.Tests" />
    <InternalsVisibleTo Include="EtAlii.Adp.Backend.Tests" />
  </ItemGroup>

</Project>
