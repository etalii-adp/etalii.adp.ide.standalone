<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp.Backend\EtAlii.Adp.Backend.csproj" />
    <!-- Explicit rather than transitive through the modules: Program.cs runs discovery itself. -->
    <ProjectReference Include="..\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <PackageReference Include="JetBrains.Annotations" />
    <!-- The host owns the Serilog pipeline every EtAlii.Adp.* assembly logs into. -->
    <PackageReference Include="Serilog.AspNetCore" />
    <ProjectReference Include="..\..\diagrams\*\backend\*\*.csproj" Exclude="..\..\diagrams\*\backend\*\*.Tests.csproj" />
    <ProjectReference Include="..\..\editors\*\backend\*\*.csproj" Exclude="..\..\editors\*\backend\*\*.Tests.csproj" />
  </ItemGroup>

  <!--
    Production hosting only (tech.md's Development tools section): the F5/local-dev loop talks
    to Vite directly via ClientAppHostingExtensions' dev-server proxy instead, so the client's
    dist/ never needs to exist for `dotnet build`/`dotnet run` - only for `dotnet publish`.
  -->
  <Target Name="BuildClientApp" BeforeTargets="Publish">
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\client" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\client" />
  </Target>

  <Target Name="PublishClientApp" BeforeTargets="ComputeFilesToPublish" DependsOnTargets="BuildClientApp">
    <ItemGroup>
      <ClientDistFile Include="$(MSBuildThisFileDirectory)..\..\client\dist\**" />
      <ResolvedFileToPublish Include="@(ClientDistFile)">
        <!-- Forward slashes: a backslash is a separator only on Windows, and this path
             decides where the publish lands on the Linux release runner too. -->
        <RelativePath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
