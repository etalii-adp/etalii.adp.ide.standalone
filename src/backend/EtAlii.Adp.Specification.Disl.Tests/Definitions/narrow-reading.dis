  "doc": "A test definition: the other of two readings of one body, which offers notes only. Written for the tests of the bundled definition set; bundled from nowhere.",
  "metamodel": {
    "types": {
      "Box": {
        "label": "Box",
        "attributes": {
          "name": {
            "type": "string"
          }
        }
      },
      "Note": {
        "label": "Note",
        "attributes": {
          "text": {
            "type": "string"
          }
        }
      }
    },
    "relations": {
      "Link": {
        "source": "Box",
        "target": "Box"
      }
    }
  },
  "toolbox": {
