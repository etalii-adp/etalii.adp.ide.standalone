      {
        "id": "notes",
        "tools": [
          {
            "id": "addNote",
            "creates": "Note",
            "label": "Sticky note"
          }
        ]
      }
    ],
    "contextMenus": [
      {
        "for": [
          "Box"
        ],
        "tools": [
          {
            "kind": "editLabel",
            "label": "Rename"
          }
        ]
      }
    ]
  }
