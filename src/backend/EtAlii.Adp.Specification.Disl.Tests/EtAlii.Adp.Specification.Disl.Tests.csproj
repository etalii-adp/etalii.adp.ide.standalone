<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- LogCapture, compiled into every test project by src/Directory.Build.targets, needs it; the
         library under test references no package that would bring it along. -->
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The two bundled DISL definitions and their provenance, under the logical names the modules embed them by. -->
    <EmbeddedResource Include="..\..\diagrams\gartner-hype-cycle-graph\definition\gartner-hype-cycle-graph.dis" LogicalName="gartner-hype-cycle-graph.dis" />
    <EmbeddedResource Include="..\..\diagrams\gartner-hype-cycle-graph\definition\provenance.json" LogicalName="gartner-hype-cycle-graph.provenance.json" />
    <EmbeddedResource Include="..\..\diagrams\agent-behavior-modelling\definition\agent-behavior-modelling.dis" LogicalName="agent-behavior-modelling.dis" />
    <EmbeddedResource Include="..\..\diagrams\agent-behavior-modelling\definition\provenance.json" LogicalName="agent-behavior-modelling.provenance.json" />
    <!-- Two test definitions of one metamodel and two origins, for the set of bundled definitions. -->
    <EmbeddedResource Include="Definitions\wide-reading.dis" LogicalName="wide-reading.dis" />
    <EmbeddedResource Include="Definitions\wide-reading.provenance.json" LogicalName="wide-reading.provenance.json" />
    <EmbeddedResource Include="Definitions\narrow-reading.dis" LogicalName="narrow-reading.dis" />
    <EmbeddedResource Include="Definitions\narrow-reading.provenance.json" LogicalName="narrow-reading.provenance.json" />
    <!-- DISL 0.6, spec 034: the example of inherited relation flags and the three specifications a loader refuses, from etalii.adp. -->
    <EmbeddedResource Include="Definitions\service-calls.dis" LogicalName="service-calls.dis" />
    <EmbeddedResource Include="Definitions\service-calls.provenance.json" LogicalName="service-calls.provenance.json" />
    <EmbeddedResource Include="Definitions\relation-flag-widened.dis" LogicalName="relation-flag-widened.dis" />
    <EmbeddedResource Include="Definitions\relation-flag-widened.provenance.json" LogicalName="relation-flag-widened.provenance.json" />
    <EmbeddedResource Include="Definitions\relation-flag-directed.dis" LogicalName="relation-flag-directed.dis" />
    <EmbeddedResource Include="Definitions\relation-flag-directed.provenance.json" LogicalName="relation-flag-directed.provenance.json" />
    <EmbeddedResource Include="Definitions\relation-flag-conflict.dis" LogicalName="relation-flag-conflict.dis" />
    <EmbeddedResource Include="Definitions\relation-flag-conflict.provenance.json" LogicalName="relation-flag-conflict.provenance.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test support of the areas these tests use; see src/Directory.Build.targets. -->
    <ProjectReference Include="..\EtAlii.Adp.Diagram.Tests.Support\EtAlii.Adp.Diagram.Tests.Support.csproj" />
    <Using Include="EtAlii.Adp.Diagram.Tests.Support" />
  </ItemGroup>

</Project>
