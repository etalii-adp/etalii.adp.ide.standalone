<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.Core.Testing" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- Content fixtures, not code fixtures: the unknown-MIME registration (Requirement 8.4)
         has to exist as a real file for DiagramFilePair to read its first line. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\diagrams\agent-behavior-modelling\backend\EtAlii.Adp.Diagram.AgentBehaviorModelling\EtAlii.Adp.Diagram.AgentBehaviorModelling.csproj" />
    <ProjectReference Include="..\..\diagrams\gartner-hype-cycle-graph\backend\EtAlii.Adp.Diagram.GartnerHypeCycleGraph\EtAlii.Adp.Diagram.GartnerHypeCycleGraph.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.TestSupport\EtAlii.Adp.TestSupport.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Backend\EtAlii.Adp.Backend.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Backend.Service\EtAlii.Adp.Backend.Service.csproj" />
  </ItemGroup>

</Project>
