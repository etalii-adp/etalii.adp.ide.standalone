<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The gRPC API alone - the service bases, ServerCallContext, RpcException - and not the
         ASP.NET Core server, which only the host project carries, so that no tool module reaches a
         hosting package (code-structure FR-054, FR-065). -->
    <PackageReference Include="Grpc.Core.Api" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" />
    <ProjectReference Include="..\EtAlii.Adp.Sessions\EtAlii.Adp.Sessions.csproj" />
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Projects\EtAlii.Adp.Projects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The context wire contract - the stream envelope and the service - owned here since
         the area extraction; the vocabulary every area speaks lives in context-contract.proto
         under Common. -->
    <Protobuf Include="..\..\api\context.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\context.proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- The context unit tests live in EtAlii.Adp.Context.Tests and reach internals - the
         moved-internals pattern, repointed when the tests followed their subject home. -->
    <InternalsVisibleTo Include="EtAlii.Adp.Context.Tests" />
  </ItemGroup>

</Project>
