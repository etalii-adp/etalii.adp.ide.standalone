<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The host side of a tool (code-structure FR-054, research R10): the gRPC services a connection
    calls, the connections and their streams, the table wire and the reload bridge. It is what
    made the diagram abstractions a host; a module references the diagram project, never this one.
  -->

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Projects\EtAlii.Adp.Projects.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Editor\EtAlii.Adp.Editor.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Designer\EtAlii.Adp.Designer.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Sessions\EtAlii.Adp.Sessions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The tests reach EditorSessionAdapter, and the analysis tests EditorService's internal constructor. -->
    <InternalsVisibleTo Include="EtAlii.Adp.Workspace.Tests" />
    <InternalsVisibleTo Include="EtAlii.Adp.Backend.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The wire these services serve (code-structure T158): the protos stay at the repository root
         and generate into the namespaces the client knows - EtAlii.Adp.Diagram.Wire,
         EtAlii.Adp.Editor.Wire and EtAlii.Adp.Designer.Wire. diagrams imports deltas, and workspace
         imports diagrams and designers, so all five are generated here together. -->
    <Protobuf Include="..\..\api\deltas.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\deltas.proto" />
    <Protobuf Include="..\..\api\diagrams.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\diagrams.proto" />
    <Protobuf Include="..\..\api\editors.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\editors.proto" />
    <Protobuf Include="..\..\api\designers.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\designers.proto" />
    <Protobuf Include="..\..\api\workspace.proto" ProtoRoot="..\..\api" GrpcServices="Both" Link="Wire\workspace.proto" />
  </ItemGroup>

</Project>
