<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The in-process host the flow tests drive over gRPC: HostFixture (one host per test class),
    FlowSession (signed in, with a project added), FlowConstants and StreamProbe. Not named
    *.Tests, so it compiles nothing of Directory.Build.targets in; a test project that runs
    flows references it.
  -->

  <ItemGroup>
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <ProjectReference Include="..\EtAlii.Adp.Backend.Service\EtAlii.Adp.Backend.Service.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.TestSupport\EtAlii.Adp.TestSupport.csproj" />
  </ItemGroup>

</Project>
