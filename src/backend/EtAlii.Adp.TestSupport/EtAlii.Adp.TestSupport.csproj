<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared, REFERENCEABLE test support - the catalog and history-host helpers that several
    test projects build hosts with (post-decomposition backlog, pulled ahead of item 10 to
    unblock items 2, 6 and 7). Deliberately NOT named *.Tests: that suffix would compile
    LogCapture into this assembly, whose [ModuleInitializer] must run once per TEST project
    - the do-not-reference trap Directory.Build.targets documents. Per-assembly support
    (LogCapture) stays source-compiled by the naming convention; support that is safe to
    share by reference lives here, public because a referenced internal helps nobody, and
    Directory.Build.targets attaches it to every test project.
  -->

  <ItemGroup>
    <PackageReference Include="Serilog" />
    <!-- The contracts every module's store and reloader tests derive from (code-structure FR-035). -->
    <PackageReference Include="xunit.v3.assert" />
    <PackageReference Include="xunit.v3.extensibility.core" />
    <!-- FakeTimeProvider, for every test project: the one clock is advanced, never slept on (code-structure FR-051). -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <!-- DrawnConnections: a module's sessions and resolvers, driven through core's own seams. -->
    <ProjectReference Include="..\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- TestFolder's report seams are internal; its own tests live in the core test project. -->
    <InternalsVisibleTo Include="EtAlii.Adp.Tests" />
  </ItemGroup>

</Project>
