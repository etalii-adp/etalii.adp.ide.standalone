<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The unknown-type fixture is created, not found (no real registration names an
         unknown MIME type); it ships to the output directory for DiagramFilePair.Tests. -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- LogCapture builds a Serilog pipeline of its own to assert on what the code logs. -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Common\EtAlii.Adp.Common.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Editor\EtAlii.Adp.Editor.csproj" />
    <!-- HistoryStack/CommandDispatcher moved to EtAlii.Adp.History (backlog item 4); eight
         Hierarchy tests drive their handlers through it. -->
    <ProjectReference Include="..\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <!-- Shared, referenceable test support (TestDiagramDefinitionCatalog, TestHistory),
         extracted from Backend.Tests ahead of item 10 to unblock this project. -->
    <ProjectReference Include="..\EtAlii.Adp.TestSupport\EtAlii.Adp.TestSupport.csproj" />
  </ItemGroup>

</Project>
