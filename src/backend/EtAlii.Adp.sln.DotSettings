<wpf:ResourceDictionary xml:space="preserve" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:s="clr-namespace:System;assembly=mscorlib" xmlns:ss="urn:shemas-jetbrains-com:settings-storage-xaml" xmlns:wpf="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
	<s:Boolean x:Key="/Default/UserDictionary/Words/=Alii/@EntryIndexedValue">True</s:Boolean>
	<s:Boolean x:Key="/Default/UserDictionary/Words/=Mindmap/@EntryIndexedValue">True</s:Boolean>
	<!-- ConvertToPrimaryConstructor, Suggestion to do not show: a primary constructor's parameter is a mutable capture, not a readonly field, so converting a constructor that assigns readonly fields either loses readonly or leaves a field that ReplaceWithPrimaryConstructorParameter then reports. Ordinary constructors with readonly fields stay. Ruled by Peter, 2026-10-07. -->
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=ConvertToPrimaryConstructor/@EntryIndexedValue">DO_NOT_SHOW</s:String>
	<!-- SuggestVarOrType_DeconstructionDeclarations, Warning: ranked Warning so the command-line inspection and Rider agree. Rider showed it at Warning from a settings layer outside the repository. Ruled by Peter, 2026-10-08. -->
	<s:String x:Key="/Default/CodeInspection/Highlighting/InspectionSeverities/=SuggestVarOrType_005FDeconstructionDeclarations/@EntryIndexedValue">WARNING</s:String></wpf:ResourceDictionary>