         does not reference EtAlii.Adp.Backend, though the design's arrow list names it:
         Backend references THIS project (its Hierarchy resolves and routes editors via
         EditorResolver / IEditorDefinitionCatalog), so referencing Backend from here
         would be a cycle. -->
    <ProjectReference Include="..\EtAlii.Adp\EtAlii.Adp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Hosting.Abstractions" />
    <PackageReference Include="Serilog" />
  </ItemGroup>

</Project>
