<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- LogCapture, compiled into every test project by src/Directory.Build.targets, needs it; the
         library under test references no package that would bring it along. -->
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EtAlii.Adp.Specification.Cel\EtAlii.Adp.Specification.Cel.csproj" />
  </ItemGroup>

</Project>
