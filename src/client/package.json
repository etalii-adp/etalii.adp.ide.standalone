{
  "name": "etalii-adp-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc --noEmit && vite build",
