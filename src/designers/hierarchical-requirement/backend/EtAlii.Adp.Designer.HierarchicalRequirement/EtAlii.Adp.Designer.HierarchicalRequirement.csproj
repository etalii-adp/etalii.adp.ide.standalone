    <EmbeddedResource Include="..\..\definition\hierarchical-requirement.fbl" LogicalName="hierarchical-requirement.fbl" />
    <EmbeddedResource Include="..\..\definition\hierarchical-requirement.md" LogicalName="hierarchical-requirement.md" />
    <EmbeddedResource Include="..\..\definition\provenance.json" LogicalName="hierarchical-requirement.provenance.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Designer.HierarchicalRequirement.Tests" />
  </ItemGroup>

</Project>
