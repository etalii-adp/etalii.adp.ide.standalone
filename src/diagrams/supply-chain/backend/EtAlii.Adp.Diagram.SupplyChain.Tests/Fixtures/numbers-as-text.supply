supply-chain: 1
# Finding B2: a number is whatever .NET reads from the scalar's text.
nodes:
  - id: a
    type: source
    name: Quoted fifty
    quantity: "50"
  - id: b
    type: processor
    name: Hexadecimal
    quantity: 0x10
  - id: c
    type: producer
    name: Infinity
    quantity: .inf
  - id: d
    type: integrator
    name: Lots
    quantity: lots
  - id: e
    type: hub
    name: Exponent
    quantity: 1e3
    step: "0.5"
  - id: f
    type: outlet
    name: Underscore
    quantity: 1_000
    x: '10'
    y: "20"
flows:
  - id: a-to-b
    from: a
    to: b
    volume: +7
