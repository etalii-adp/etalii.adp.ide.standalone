sankey: 1
# A7: a node with no id and a later holder of an id are reported and not drawn,
# their flows count towards nothing, and nothing writes an id for them.
nodes:
  - name: Nameless
  - id: a
    name: A
  - id: b
    name: B
  - id: a
    name: A again
  - id: c
    name: C
flows:
  - from: a
    to: b
    value: 5
  - from: b
    to: c
    value: 3
  - id: b
    from: c
    to: a
    value: 2
