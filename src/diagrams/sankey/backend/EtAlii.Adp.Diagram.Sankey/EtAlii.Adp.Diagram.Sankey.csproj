<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Core abstractions only: the dependency runs module -> core and never back. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram.Modules\EtAlii.Adp.Diagram.Modules.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Whether a body is YAML (SankeyBody.Refusal) only: every write is a model change the FBL binding plans as splices. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- This type's own wire payloads, packed into the core Element's Any. -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DISL definition bundled from etalii-adp/etalii.adp (src/diagrams/tools/bundle-disl.sh), and its provenance. The palette, the menus and the rows are derived from it (SankeyDefinition). -->
    <EmbeddedResource Include="..\..\definition\sankey.dis" LogicalName="sankey.dis" />
    <EmbeddedResource Include="..\..\definition\provenance.json" LogicalName="sankey.provenance.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The FBL binding of the .skv body (sankey-disl-fbl), through which SankeyBody reads it. -->
    <EmbeddedResource Include="sankey.fbl" LogicalName="sankey.fbl" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.Sankey.Tests" />
  </ItemGroup>

</Project>
