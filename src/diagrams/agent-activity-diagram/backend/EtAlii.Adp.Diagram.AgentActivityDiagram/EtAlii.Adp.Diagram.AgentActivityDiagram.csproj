<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Core abstractions only, and the dependency runs module -> core and never back. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
    <!-- The body is read and written through FBL: the bundled binding, applied by the library. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl\EtAlii.Adp.Specification.Fbl.csproj" />
    <!-- The toolbox, the context menus, the property rows and the findings are derived from the bundled DISL definition. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- This type's own wire payload, packed into the core Element's Any. -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The definition bundled from etalii-adp/etalii.adp (src/diagrams/tools/bundle-disl.sh): the DISL
      specification, the FBL binding of the .aad body, and the provenance of the two.
    -->
    <EmbeddedResource Include="..\..\definition\agent-activity-diagram.dis" LogicalName="agent-activity-diagram.dis" />
    <EmbeddedResource Include="..\..\definition\agent-activity-diagram.fbl" LogicalName="agent-activity-diagram.fbl" />
    <EmbeddedResource Include="..\..\definition\provenance.json" LogicalName="agent-activity-diagram.provenance.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.AgentActivityDiagram.Tests" />
  </ItemGroup>

</Project>
