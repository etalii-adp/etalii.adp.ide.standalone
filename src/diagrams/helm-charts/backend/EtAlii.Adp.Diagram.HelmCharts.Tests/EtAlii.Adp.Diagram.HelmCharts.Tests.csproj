<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.HelmCharts\EtAlii.Adp.Diagram.HelmCharts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Fixture charts beside the test binary so a test reads them from disk exactly as the
      backend will. PreserveNewest rather than Always: the zero-writes proof compares the tree
      byte-for-byte against the copy it took, so the copy must not be rewritten under a
      running test. The glob matches nothing until the reader task adds the fixtures, which is
      a no-op rather than an error.
    -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
