<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
    <!--
      Core abstractions only. The dependency runs module -> core and never back, and never
      sideways: a causal loop diagram states feedback structure and shares no engine with any
      other module. What it consumes from the family - the canvas conventions and the .adp
      layout block - arrives through core alone.
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- This module's own wire payloads, packed into the core Element's Any. -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DISL definition bundled from etalii-adp/etalii.adp (src/diagrams/tools/bundle-disl.sh), and its provenance. -->
    <EmbeddedResource Include="..\..\definition\causal-loop-diagram.dis" LogicalName="causal-loop-diagram.dis" />
    <EmbeddedResource Include="..\..\definition\provenance.json" LogicalName="causal-loop-diagram.provenance.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module's own FBL binding (causal-loop-disl-fbl Requirement 4.1), which the definition's persistence.binding names. -->
    <EmbeddedResource Include="causal-loop-diagram.fbl" LogicalName="causal-loop-diagram.fbl" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.CausalLoopDiagram.Tests" />
  </ItemGroup>

</Project>
