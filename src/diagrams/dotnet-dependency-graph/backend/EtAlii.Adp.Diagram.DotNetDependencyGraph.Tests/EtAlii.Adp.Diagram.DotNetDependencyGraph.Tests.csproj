<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <!-- The context seam this module's property provider implements. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.DotNetDependencyGraph\EtAlii.Adp.Diagram.DotNetDependencyGraph.csproj" />
    <!-- The module's flows over the real host (code-structure T251). -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Backend.Tests.Support\EtAlii.Adp.Backend.Tests.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Solutions and project files beside the test binary, so a test reads them from disk
      exactly as the backend will. PreserveNewest rather than Always: these fixtures are the
      subject of read-only assertions, and a copy rewritten under a running test would make a
      failure look like a parser bug.
    -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test support of the areas these tests use; see src/Directory.Build.targets. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram.Tests.Support\EtAlii.Adp.Diagram.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Files.Tests.Support\EtAlii.Adp.Files.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History.Tests.Support\EtAlii.Adp.History.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl.Tests.Support\EtAlii.Adp.Specification.Disl.Tests.Support.csproj" />
    <Using Include="EtAlii.Adp.Backend.Tests.Support" />
    <Using Include="EtAlii.Adp.Diagram.Tests.Support" />
    <Using Include="EtAlii.Adp.Files.Tests.Support" />
    <Using Include="EtAlii.Adp.History.Tests.Support" />
    <Using Include="EtAlii.Adp.Specification.Disl.Tests.Support" />
  </ItemGroup>

</Project>
