    start: 1978-02
    stop: 1998-01
    row: 20
    phases: 4
    tags: [community]
  - id: usenet
    name: Usenet
    start: 1980-01
    stop: 2000-01
    row: 22
    phases: 4
    tags: [community, communication]
  - id: world-wide-web
    name: World Wide Web
    start: 1989-03
    stop: 2012-01
    row: 24
    phases: 4
    tags: [web]
  - id: web-browsers
    name: Web browsers
    start: 1993-04
    stop: 2015-01
    row: 26
    phases: 4
    tags: [web]
    description: From Mosaic in 1993 through the browser wars.
  - id: search-engines
    name: Search engines
    start: 1994-01
