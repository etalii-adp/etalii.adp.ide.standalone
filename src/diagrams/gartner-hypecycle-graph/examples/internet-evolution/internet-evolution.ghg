    phases: 4
    tags: [access]
  - id: broadband
    name: Broadband
    start: 1999-01
    stop: 2020-01
    row: 12
    phases: 4
    tags: [access]
  - id: mobile-internet
    name: Mobile internet
    start: 2007-06
    stop: 2026-01
    row: 14
    phases: 4
    tags: [access]
    description: The smartphone put the internet in every pocket.
  - id: 5g
    name: 5G
    start: 2019-04
    stop: 2032-01
    row: 8
    phases: 2
    tags: [access]
  - id: satellite-internet
    name: Satellite broadband constellations
    start: 2019-05
    stop: 2040-01
    row: 16
    phases: 1
    tags: [access, space]
    description: Thousands of low-orbit satellites, from Starlink's first launch in 2019.
  - id: email
    name: Email
    start: 1971-10
    stop: 2005-01
    row: 18
    phases: 4
    tags: [communication]
  - id: bulletin-board-systems
