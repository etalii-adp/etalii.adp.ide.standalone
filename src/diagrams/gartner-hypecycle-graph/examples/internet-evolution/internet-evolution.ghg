gartner-hypecycle-graph: 1
# A hand-authored hype cycle of the internet, from packet switching to ideas that have not started
# yet. Dates after 2026 are projections, and dates and influences are illustrative, not a claim:
# see readme.md.
trends:
  - id: packet-switching
    name: Packet switching
    start: 1964-08
    stop: 1985-01
    row: 0
    phases: 4
    tags: [networking]
    description: Paul Baran's and Donald Davies's idea of cutting messages into independently routed packets.
  - id: arpanet
    name: ARPANET
    start: 1969-10
    stop: 1990-02
    row: 2
    phases: 4
    tags: [networking]
  - id: tcp-ip
    name: TCP/IP
    start: 1974-05
    stop: 2000-01
    row: 4
    phases: 4
    tags: [networking]
    description: Cerf and Kahn's protocols of 1974; ARPANET switched over on 1 January 1983.
  - id: dns
    name: Domain Name System
    start: 1983-11
    stop: 2005-01
    row: 6
    phases: 4
    tags: [networking]
  - id: nsfnet
    name: NSFNET
    start: 1985-01
    stop: 1995-04
    row: 0
    phases: 4
    tags: [networking]
    description: The academic backbone whose opening to commercial traffic began the public internet.
  - id: cdn
    name: Content delivery networks
    start: 1998-08
    stop: 2026-01
    row: 0
    phases: 4
    tags: [infrastructure]
  - id: ipv6
    name: IPv6
    start: 1998-12
    stop: 2035-01
    row: 2
    phases: 3
    tags: [networking]
  - id: cloud-computing
    name: Cloud computing
    start: 2006-08
    stop: 2026-01
    row: 4
    phases: 4
    tags: [infrastructure]
  - id: dial-up-access
