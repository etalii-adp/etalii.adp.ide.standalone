<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <!-- The bundled definition is loaded as the runtime loads it, so its test sees what a load reports. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.Sparql\EtAlii.Adp.Diagram.Sparql.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The parser corpus, beside the test binary so a test reads a query from disk exactly as the
      backend will. PreserveNewest, and the fixtures are `-text` in .gitattributes: the CRLF/LF
      pair exists to prove the parser is indifferent to line endings, which requires the pair to
      stay two different files.
    -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test support of the areas these tests use; see src/Directory.Build.targets. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram.Tests.Support\EtAlii.Adp.Diagram.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents.Tests.Support\EtAlii.Adp.Documents.Tests.Support.csproj" />
    <Using Include="EtAlii.Adp.Diagram.Tests.Support" />
    <Using Include="EtAlii.Adp.Documents.Tests.Support" />
  </ItemGroup>

</Project>
