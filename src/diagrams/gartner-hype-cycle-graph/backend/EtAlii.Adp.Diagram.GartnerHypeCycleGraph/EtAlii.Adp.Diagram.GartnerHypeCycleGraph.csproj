<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Core abstractions only, and the dependency runs module -> core and never back, as FDG's. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
    <!-- The body is read and written through FBL: the binding below, applied by the library. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl\EtAlii.Adp.Specification.Fbl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- This type's own wire payload, packed into the core Element's Any. -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- The FBL binding of the .ghg body, loaded once by GhgBody. -->
    <EmbeddedResource Include="gartner-hype-cycle-graph.fbl" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.GartnerHypeCycleGraph.Tests" />
  </ItemGroup>

</Project>
