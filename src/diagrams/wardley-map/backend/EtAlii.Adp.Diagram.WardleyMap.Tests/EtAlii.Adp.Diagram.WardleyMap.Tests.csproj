<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.WardleyMap\EtAlii.Adp.Diagram.WardleyMap.csproj" />
    <!-- The module's flows over the real host (code-structure T303). -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Backend.Tests.Support\EtAlii.Adp.Backend.Tests.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      .owm documents the parser and writer are tested against, beside the test binary so a test
      reads them from disk exactly as the backend will. PreserveNewest rather than Always: a
      byte-for-byte round-trip test compares against the file it copied, so the copy must not be
      rewritten under a running test.

      certify.mjs is excluded - it is a developer tool for re-certifying the corpus against the
      real OnlineWardleyMaps parser (see Fixtures/readme.md), not an input to any test.
    -->
    <Content Include="Fixtures\**" Exclude="Fixtures\certify.mjs" CopyToOutputDirectory="PreserveNewest" />
    <!-- The definition at DISL 0.1, which LegacyDefinition.Tests holds findings A1 to A3 to. -->
    <Content Include="Legacy\wardley-map.dis" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test support of the areas these tests use; see src/Directory.Build.targets. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram.Tests.Support\EtAlii.Adp.Diagram.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents.Tests.Support\EtAlii.Adp.Documents.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl.Tests.Support\EtAlii.Adp.Specification.Disl.Tests.Support.csproj" />
    <Using Include="EtAlii.Adp.Backend.Tests.Support" />
    <Using Include="EtAlii.Adp.Diagram.Tests.Support" />
    <Using Include="EtAlii.Adp.Documents.Tests.Support" />
    <Using Include="EtAlii.Adp.Specification.Disl.Tests.Support" />
  </ItemGroup>

</Project>
