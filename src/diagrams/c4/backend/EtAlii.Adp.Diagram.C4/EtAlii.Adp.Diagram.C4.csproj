<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram.Modules\EtAlii.Adp.Diagram.Modules.csproj" />
    <!-- The six bundled DISL definitions are loaded through it (C4Definitions). -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
    <!--
      Core abstractions only. The dependency runs modules -> shared library -> core and never
      back: core must compile and test with every C4 module absent. The seven c4-* projects
      reference this library; this library references none of them (c4-diagrams design,
      "Project Structure").
    -->
  </ItemGroup>

  <ItemGroup>
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!--
      The family's own wire payloads, packed into the core Element's Any. One api folder for
      all seven types, because they share one model (c4-diagrams Requirement 1).
    -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The six DISL definitions bundled from etalii-adp/etalii.adp (src/diagrams/tools/bundle-disl.sh),
      each with its provenance, embedded as c4-context.dis and c4-context.provenance.json and so on.
    -->
    <EmbeddedResource Include="..\..\definition\*.dis" LogicalName="%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\definition\*.provenance.json" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The module's own FBL binding of a Structurizr DSL workspace, which the six definitions name as
      their persistence.binding, and the grammar beside it that it names (FBL 0.15, the grammar family).
      structurizr.fbl is etalii.adp's specifications/fbl/structurizr.fbl as of commit 1428ae2 (the merge of
      etalii.adp #685: a relationship with no source reads its enclosing element as from), and
      structurizr.lark is etalii.adp's as of commit 55b62e1 (the merge of etalii.adp #684: keywords written as
      "x"i strings by the ATD 0.1 amendment of 2026-11-01), both byte for byte: a change goes to etalii.adp and
      is copied again. C4Body reads every body through them (c4-disl-fbl task 14).
    -->
    <EmbeddedResource Include="structurizr.fbl" LogicalName="structurizr.fbl" />
    <EmbeddedResource Include="structurizr.lark" LogicalName="structurizr.lark" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.C4.Tests" />
  </ItemGroup>

</Project>
