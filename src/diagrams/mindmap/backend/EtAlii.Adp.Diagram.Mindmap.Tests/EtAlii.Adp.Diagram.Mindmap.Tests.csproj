<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.Mindmap\EtAlii.Adp.Diagram.Mindmap.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Real .mm files the parser and serializer are tested against, beside the test binary so a
      test reads them from disk exactly as the backend will. PreserveNewest rather than Always:
      a byte-for-byte round-trip test compares against the file it copied, so the copy must not
      be rewritten under a running test.
    -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The FBL implementation's real-file cross-check of this module (Requirement 11.6), with the corpus, the vendored
      bindings and the ledger of divergences it reads, compiled from EtAlii.Adp.Specification.Fbl.Tests rather than
      copied, so that project references no tool module and the ledger stays one (code-structure T287).
    -->
    <Compile Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl.Tests\Support\Repository.cs" Link="CrossCheck\Repository.cs" />
    <Compile Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl.Tests\Support\NaturalIds.cs" Link="CrossCheck\NaturalIds.cs" />
    <Compile Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl.Tests\RealFiles\RealFileCorpus.cs" Link="CrossCheck\RealFileCorpus.cs" />
    <Compile Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl.Tests\RealFiles\Divergences.cs" Link="CrossCheck\Divergences.cs" />
    <Compile Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl.Tests\RealFiles\ModuleCrossCheck.cs" Link="CrossCheck\ModuleCrossCheck.cs" />
  </ItemGroup>

</Project>
