<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.Timeline\EtAlii.Adp.Diagram.Timeline.csproj" />
    <!-- The module's flows over the real host (code-structure T303). -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Backend.Tests.Support\EtAlii.Adp.Backend.Tests.Support.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The round-trip corpus, beside the test binary so a test reads a document from disk exactly
      as the backend will. PreserveNewest rather than Always: a byte-for-byte round-trip test
      compares against the file it copied, so the copy must not be rewritten under a running test.
    -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The FBL conformance corpus's example timeline binding, unchanged, which Parity/TimelineFindings.Tests.cs
      reads every finding's fixture through (timeline-disl-fbl task 1). Linked rather than copied, so it
      cannot drift from the vendored file.
    -->
    <None Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl.Tests\Conformance\timeline.fbl" Link="Parity\timeline.fbl" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test support of the areas these tests use; see src/Directory.Build.targets. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram.Tests.Support\EtAlii.Adp.Diagram.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents.Tests.Support\EtAlii.Adp.Documents.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History.Tests.Support\EtAlii.Adp.History.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl.Tests.Support\EtAlii.Adp.Specification.Disl.Tests.Support.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl.Tests.Support\EtAlii.Adp.Specification.Fbl.Tests.Support.csproj" />
    <Using Include="EtAlii.Adp.Backend.Tests.Support" />
    <Using Include="EtAlii.Adp.Diagram.Tests.Support" />
    <Using Include="EtAlii.Adp.Documents.Tests.Support" />
    <Using Include="EtAlii.Adp.History.Tests.Support" />
    <Using Include="EtAlii.Adp.Specification.Disl.Tests.Support" />
    <Using Include="EtAlii.Adp.Specification.Fbl.Tests.Support" />
  </ItemGroup>

</Project>
