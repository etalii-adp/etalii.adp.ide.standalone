<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.AzurePipeline\EtAlii.Adp.Diagram.AzurePipeline.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Real pipeline documents the parser and writer are tested against, beside the test binary
      so a test reads them from disk exactly as the backend will. PreserveNewest rather than
      Always: a byte-for-byte round-trip test compares against the file it copied, so the copy
      must not be rewritten under a running test.
    -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
