<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <!--
      Core abstractions only: the context resolver and property provider seams, and the diagram
      session seam. The dependency runs this way and never back - core must compile and test
      with this module absent (structure.md's dependency direction).
    -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Backend\EtAlii.Adp.Backend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!--
      Read-only, so the parser only ever has to understand YAML, never reproduce it. Its node
      marks carry the line a value was declared on, which is what a problem points at.
    -->
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The module's own wire payload, packed into the core Element's Any. Lives under the
      module's api folder; core protos are never edited from here. The glob matches nothing
      until task 14 adds ansible-structure.proto, which is a no-op rather than an error.
    -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.AnsibleStructure.Tests" />
  </ItemGroup>

</Project>
