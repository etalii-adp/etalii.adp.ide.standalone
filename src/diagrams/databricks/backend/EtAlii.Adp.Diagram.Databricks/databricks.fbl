{
  "$schema": "https://etalii.net/adp/fbl/schema/0.1/fbl.schema.json#/$defs/Document",
  "fbl": "0.10",
  "doc": "The Databricks module's one binding (databricks-disl-fbl task 11): etalii.adp's specifications/fbl/databricks.fbl, which names the three readings of one Databricks file, with what the module's three readers read besides: the includes and variables, the configuration it does not model as Unknown, a target's overrides, a task's source and a task without a key, a pipeline's notifications, a flag read as true only when it is written true, and a dependency read as an element with its two ends, so that one on a task the job does not declare is kept (DISL gap 8, finding A9).",
  "bindings": {
    "configuration": {
      "title": "Databricks configuration",
      "claims": {
        "extensions": [
          ".yml",
          ".yaml",
          ".json"
        ],
        "shared": true,
        "registrationOnly": true,
        "origins": [
          "databricks/bundle",
          "databricks/job",
          "databricks/pipeline"
        ],
        "suggest": {
          "contains": [
            "bundle:",
            "resources:"
          ]
        }
      },
      "body": {
        "kind": "file",
        "family": "json",
        "alsoRead": [
          "yaml"
        ]
      },
      "reader": "declared",
      "text": {
        "newline": "crlf",
        "indent": 2,
        "sequenceIndent": "indented",
        "finalNewline": true,
        "quote": "double"
      },
      "registration": {
        "resource": {
          "byOrigin": {
            "databricks/job": {
              "capture": "job"
            },
            "databricks/pipeline": {
              "capture": "pipeline"
            },
            "databricks/bundle": null
          }
        },
        "createOnFirstPlacement": false
      },
      "elements": [
        {
          "name": "bundleFile",
          "type": "BundleFile",
          "at": "/",
          "origins": [
            "databricks/bundle"
          ],
          "when": "type(text) == map",
          "readOnly": "The includes and variables are edited in the file.",
          "attributes": {
            "includes": {
              "value": "has(text.include) && type(text.include) == list ? text.include.filter(i, type(i) == string) : []"
            },
            "variables": {
              "value": "has(text.variables) && type(text.variables) == map ? text.variables.map(k, {'name': k, 'default': type(text.variables[k]) == map ? (has(text.variables[k].default) && type(text.variables[k].default) == string ? text.variables[k].default : '') : '', 'description': type(text.variables[k]) == map ? (has(text.variables[k].description) && type(text.variables[k].description) == string ? text.variables[k].description : '') : ''}) : []"
            }
          }
        },
        {
          "name": "bundle",
          "type": "Bundle",
          "at": "/bundle",
          "origins": [
            "databricks/bundle"
          ],
          "attributes": {
            "name": {
              "key": "name",
              "read": "text",
              "empty": "refuse",
              "refusals": {
                "empty": "A bundle needs a name."
              }
            }
          }
        },
        {
          "name": "jobResource",
          "type": "Resource",
          "at": "/resources/jobs/{job}",
          "origins": [
            "databricks/bundle"
          ],
          "attributes": {
            "resourceKind": {
              "value": "'jobs'"
            },
            "key": {
              "capture": "job",
              "readOnly": "A resource is renamed in the file."
            }
          }
        },
        {
          "name": "pipelineResource",
          "type": "Resource",
          "at": "/resources/pipelines/{pipeline}",
          "origins": [
            "databricks/bundle"
          ],
          "attributes": {
            "resourceKind": {
              "value": "'pipelines'"
            },
            "key": {
              "capture": "pipeline",
              "readOnly": "A resource is renamed in the file."
            }
          }
        },
        {
          "name": "unknownKey",
          "type": "Unknown",
          "at": "/{key}",
          "origins": [
            "databricks/bundle"
          ],
          "when": "!(path.key in ['bundle', 'include', 'variables', 'resources', 'targets'])",
          "readOnly": "Configuration the diagram does not model is edited in the file.",
          "attributes": {
            "path": {
              "value": "path.key"
            },
            "key": {
              "value": "path.key"
            }
          }
        },
        {
          "name": "unknownKind",
          "type": "Unknown",
          "at": "/resources/{kind}",
          "origins": [
            "databricks/bundle"
          ],
          "when": "!(path.kind in ['jobs', 'pipelines'])",
          "readOnly": "Configuration the diagram does not model is edited in the file.",
          "attributes": {
            "path": {
              "value": "'resources.' + path.kind"
            },
            "key": {
              "value": "path.kind"
            }
          }
        },
        {
          "name": "target",
          "type": "Target",
          "at": "/targets/{target}",
          "origins": [
            "databricks/bundle"
          ],
          "attributes": {
            "name": {
              "capture": "target",
              "readOnly": "A target is renamed in the file."
            },
            "mode": {
              "key": "mode",
              "read": "text",
              "empty": "remove"
            },
            "isDefault": {
              "value": "type(text) == map && has(text.default) && type(text.default) == string && text.default.lowerAscii() == 'true'",
              "readOnly": true
            }
          },
          "when": "type(entry) == map"
        },
        {
          "name": "override",
          "type": "Override",
          "at": "/targets/{target}/resources/{kind}/{key}",
          "origins": [
            "databricks/bundle"
          ],
          "readOnly": "An override is edited in the file.",
          "attributes": {
            "resourceKind": {
              "capture": "kind"
            },
            "resourceKey": {
              "capture": "key"
            },
            "from": {
              "value": "path.target"
            },
            "to": {
              "value": "'resource:' + path.kind + '/' + path.key"
            }
          }
        },
        {
          "name": "job",
          "type": "Job",
          "at": "/resources/jobs/{job}",
          "origins": [
            "databricks/job"
          ],
          "attributes": {
            "jobKey": {
              "capture": "job",
              "readOnly": true
            },
            "name": {
              "key": "name",
              "read": "text"
            },
            "schedule": {
              "value": "has(text.schedule) && type(text.schedule) == map ? (has(text.schedule.quartz_cron_expression) && type(text.schedule.quartz_cron_expression) == string ? text.schedule.quartz_cron_expression : '') : ''",
              "readOnly": "The schedule is edited in the file."
            },
            "continuous": {
              "value": "has(entry.continuous)"
            }
          },
          "when": "type(entry) == map"
        },
        {
          "name": "task",
          "type": "Task",
          "at": "/resources/jobs/{job}/tasks/*",
          "origins": [
            "databricks/job"
          ],
          "when": "type(text) == map && has(text.task_key) && type(text.task_key) == string && text.task_key != ''",
          "attributes": {
            "key": {
              "key": "task_key",
              "read": "text",
              "reference": {
                "to": [
                  "task"
                ],
                "by": "key"
              },
              "empty": "refuse",
              "refusals": {
                "empty": "A task needs a key."
              }
            },
            "taskType": {
              "value": "((has(text.notebook_task) && type(text.notebook_task) == map) ? 'notebook' : ((has(text.spark_python_task) && type(text.spark_python_task) == map) ? 'python' : ((has(text.python_wheel_task) && type(text.python_wheel_task) == map) ? 'wheel' : ((has(text.sql_task) && type(text.sql_task) == map) ? 'sql' : ((has(text.dbt_task) && type(text.dbt_task) == map) ? 'dbt' : ((has(text.pipeline_task) && type(text.pipeline_task) == map) ? 'pipeline' : ((has(text.run_job_task) && type(text.run_job_task) == map) ? 'run-job' : ((has(text.condition_task) && type(text.condition_task) == map) ? 'condition' : ((has(text.for_each_task) && type(text.for_each_task) == map) ? 'for-each' : ((has(text.spark_jar_task) && type(text.spark_jar_task) == map) ? 'jar' : 'other'))))))))))",
              "readOnly": "The type is which *_task mapping the file carries; change it in the file."
            },
            "clusterKey": {
              "key": "job_cluster_key",
              "read": "text",
              "empty": "remove",
              "reference": {
                "to": [
                  "cluster"
                ],
                "by": "key"
              }
            },
            "runIf": {
              "key": "run_if",
              "read": "text",
              "empty": "remove"
            },
            "taskSource": {
              "value": "((has(text.notebook_task) && type(text.notebook_task) == map) ? (has(text.notebook_task.notebook_path) && type(text.notebook_task.notebook_path) == string ? text.notebook_task.notebook_path : '') : ((has(text.spark_python_task) && type(text.spark_python_task) == map) ? (has(text.spark_python_task.python_file) && type(text.spark_python_task.python_file) == string ? text.spark_python_task.python_file : '') : ((has(text.python_wheel_task) && type(text.python_wheel_task) == map) ? (has(text.python_wheel_task.entry_point) && type(text.python_wheel_task.entry_point) == string ? text.python_wheel_task.entry_point : '') : ((has(text.sql_task) && type(text.sql_task) == map) ? ((has(text.sql_task.query) && type(text.sql_task.query) == map) ? (has(text.sql_task.query.query_id) && type(text.sql_task.query.query_id) == string ? text.sql_task.query.query_id : (has(text.sql_task.query.path) && type(text.sql_task.query.path) == string ? text.sql_task.query.path : '')) : ((has(text.sql_task.dashboard) && type(text.sql_task.dashboard) == map) ? (has(text.sql_task.dashboard.dashboard_id) && type(text.sql_task.dashboard.dashboard_id) == string ? text.sql_task.dashboard.dashboard_id : (has(text.sql_task.dashboard.path) && type(text.sql_task.dashboard.path) == string ? text.sql_task.dashboard.path : '')) : ((has(text.sql_task.alert) && type(text.sql_task.alert) == map) ? (has(text.sql_task.alert.alert_id) && type(text.sql_task.alert.alert_id) == string ? text.sql_task.alert.alert_id : (has(text.sql_task.alert.path) && type(text.sql_task.alert.path) == string ? text.sql_task.alert.path : '')) : ((has(text.sql_task.file) && type(text.sql_task.file) == map) ? (has(text.sql_task.file.file_id) && type(text.sql_task.file.file_id) == string ? text.sql_task.file.file_id : (has(text.sql_task.file.path) && type(text.sql_task.file.path) == string ? text.sql_task.file.path : '')) : '')))) : ((has(text.dbt_task) && type(text.dbt_task) == map) ? (has(text.dbt_task.project_directory) && type(text.dbt_task.project_directory) == string ? text.dbt_task.project_directory : '') : ((has(text.pipeline_task) && type(text.pipeline_task) == map) ? (has(text.pipeline_task.pipeline_id) && type(text.pipeline_task.pipeline_id) == string ? text.pipeline_task.pipeline_id : '') : ((has(text.run_job_task) && type(text.run_job_task) == map) ? (has(text.run_job_task.job_id) && type(text.run_job_task.job_id) == string ? text.run_job_task.job_id : '') : ((has(text.condition_task) && type(text.condition_task) == map) ? (has(text.condition_task.op) && type(text.condition_task.op) == string ? text.condition_task.op : '') : ((has(text.for_each_task) && type(text.for_each_task) == map) ? (has(text.for_each_task.inputs) && type(text.for_each_task.inputs) == string ? text.for_each_task.inputs : '') : ((has(text.spark_jar_task) && type(text.spark_jar_task) == map) ? (has(text.spark_jar_task.main_class_name) && type(text.spark_jar_task.main_class_name) == string ? text.spark_jar_task.main_class_name : '') : ''))))))))))",
              "readOnly": "The source is edited in the file."
            }
          },
          "insert": {
            "place": "after-last",
            "container": "/resources/jobs/{job}/tasks",
            "keys": [
              "task_key",
              "depends_on",
              "job_cluster_key",
              "run_if"
            ],
            "skeleton": "notebook_task:\n  notebook_path: notebooks/{key}\n",
            "refusals": {
              "container": "The job has no tasks section to add into."
            }
          },
          "remove": {
            "cascade": [
              "dependency"
            ]
          }
        },
        {
          "name": "keylessTask",
          "type": "KeylessTask",
          "at": "/resources/jobs/{job}/tasks/*",
          "origins": [
            "databricks/job"
          ],
          "when": "type(text) == map",
          "readOnly": "A task without a task_key is edited in the file.",
          "attributes": {
            "taskType": {
              "value": "((has(text.notebook_task) && type(text.notebook_task) == map) ? 'notebook' : ((has(text.spark_python_task) && type(text.spark_python_task) == map) ? 'python' : ((has(text.python_wheel_task) && type(text.python_wheel_task) == map) ? 'wheel' : ((has(text.sql_task) && type(text.sql_task) == map) ? 'sql' : ((has(text.dbt_task) && type(text.dbt_task) == map) ? 'dbt' : ((has(text.pipeline_task) && type(text.pipeline_task) == map) ? 'pipeline' : ((has(text.run_job_task) && type(text.run_job_task) == map) ? 'run-job' : ((has(text.condition_task) && type(text.condition_task) == map) ? 'condition' : ((has(text.for_each_task) && type(text.for_each_task) == map) ? 'for-each' : ((has(text.spark_jar_task) && type(text.spark_jar_task) == map) ? 'jar' : 'other'))))))))))"
            },
            "taskSource": {
              "value": "((has(text.notebook_task) && type(text.notebook_task) == map) ? (has(text.notebook_task.notebook_path) && type(text.notebook_task.notebook_path) == string ? text.notebook_task.notebook_path : '') : ((has(text.spark_python_task) && type(text.spark_python_task) == map) ? (has(text.spark_python_task.python_file) && type(text.spark_python_task.python_file) == string ? text.spark_python_task.python_file : '') : ((has(text.python_wheel_task) && type(text.python_wheel_task) == map) ? (has(text.python_wheel_task.entry_point) && type(text.python_wheel_task.entry_point) == string ? text.python_wheel_task.entry_point : '') : ((has(text.sql_task) && type(text.sql_task) == map) ? ((has(text.sql_task.query) && type(text.sql_task.query) == map) ? (has(text.sql_task.query.query_id) && type(text.sql_task.query.query_id) == string ? text.sql_task.query.query_id : (has(text.sql_task.query.path) && type(text.sql_task.query.path) == string ? text.sql_task.query.path : '')) : ((has(text.sql_task.dashboard) && type(text.sql_task.dashboard) == map) ? (has(text.sql_task.dashboard.dashboard_id) && type(text.sql_task.dashboard.dashboard_id) == string ? text.sql_task.dashboard.dashboard_id : (has(text.sql_task.dashboard.path) && type(text.sql_task.dashboard.path) == string ? text.sql_task.dashboard.path : '')) : ((has(text.sql_task.alert) && type(text.sql_task.alert) == map) ? (has(text.sql_task.alert.alert_id) && type(text.sql_task.alert.alert_id) == string ? text.sql_task.alert.alert_id : (has(text.sql_task.alert.path) && type(text.sql_task.alert.path) == string ? text.sql_task.alert.path : '')) : ((has(text.sql_task.file) && type(text.sql_task.file) == map) ? (has(text.sql_task.file.file_id) && type(text.sql_task.file.file_id) == string ? text.sql_task.file.file_id : (has(text.sql_task.file.path) && type(text.sql_task.file.path) == string ? text.sql_task.file.path : '')) : '')))) : ((has(text.dbt_task) && type(text.dbt_task) == map) ? (has(text.dbt_task.project_directory) && type(text.dbt_task.project_directory) == string ? text.dbt_task.project_directory : '') : ((has(text.pipeline_task) && type(text.pipeline_task) == map) ? (has(text.pipeline_task.pipeline_id) && type(text.pipeline_task.pipeline_id) == string ? text.pipeline_task.pipeline_id : '') : ((has(text.run_job_task) && type(text.run_job_task) == map) ? (has(text.run_job_task.job_id) && type(text.run_job_task.job_id) == string ? text.run_job_task.job_id : '') : ((has(text.condition_task) && type(text.condition_task) == map) ? (has(text.condition_task.op) && type(text.condition_task.op) == string ? text.condition_task.op : '') : ((has(text.for_each_task) && type(text.for_each_task) == map) ? (has(text.for_each_task.inputs) && type(text.for_each_task.inputs) == string ? text.for_each_task.inputs : '') : ((has(text.spark_jar_task) && type(text.spark_jar_task) == map) ? (has(text.spark_jar_task.main_class_name) && type(text.spark_jar_task.main_class_name) == string ? text.spark_jar_task.main_class_name : '') : ''))))))))))"
            },
            "clusterKey": {
              "value": "(has(text.job_cluster_key) && type(text.job_cluster_key) == string ? text.job_cluster_key : '')"
            },
            "runIf": {
              "value": "(has(text.run_if) && type(text.run_if) == string ? text.run_if : '')"
            }
          }
        },
        {
          "name": "cluster",
          "type": "JobCluster",
          "at": "/resources/jobs/{job}/job_clusters/*",
          "origins": [
            "databricks/job"
          ],
          "when": "type(text) == map && has(text.job_cluster_key) && type(text.job_cluster_key) == string && text.job_cluster_key != ''",
          "attributes": {
            "key": {
              "key": "job_cluster_key",
              "read": "text",
              "reference": {
                "to": [
                  "cluster"
                ],
                "by": "key"
              }
            },
            "sparkVersion": {
              "key": "spark_version",
              "child": "new_cluster",
              "read": "text"
            },
            "nodeType": {
              "key": "node_type_id",
              "child": "new_cluster",
              "read": "text"
            },
            "workers": {
              "value": "has(text.new_cluster) && type(text.new_cluster) == map && has(text.new_cluster.num_workers) && type(text.new_cluster.num_workers) == string && text.new_cluster.num_workers.trim().matches('^[+-]?[0-9]{1,9}$') ? int(text.new_cluster.num_workers.trim()) : 0",
              "readOnly": true
            }
          },
          "readOnly": "Job clusters are edited in the file."
        },
        {
          "name": "pipeline",
          "type": "Pipeline",
          "at": "/resources/pipelines/{pipeline}",
          "origins": [
            "databricks/pipeline"
          ],
          "attributes": {
            "name": {
              "key": "name",
              "read": "text",
              "empty": "refuse",
              "refusals": {
                "empty": "A pipeline needs a name."
              }
            },
            "catalog": {
              "key": "catalog",
              "read": "text",
              "empty": "remove"
            },
            "schema": {
              "key": "schema",
              "read": "text",
              "empty": "remove",
              "secondary": {
                "key": "target"
              }
            },
            "channel": {
              "key": "channel",
              "read": "text",
              "empty": "remove"
            },
            "serverless": {
              "value": "type(text) == map && has(text.serverless) && type(text.serverless) == string && text.serverless.lowerAscii() == 'true'",
              "readOnly": true
            },
            "continuous": {
              "value": "type(text) == map && has(text.continuous) && type(text.continuous) == string && text.continuous.lowerAscii() == 'true'",
              "readOnly": true
            },
            "development": {
              "value": "type(text) == map && has(text.development) && type(text.development) == string && text.development.lowerAscii() == 'true'",
              "readOnly": true
            }
          },
          "when": "type(entry) == map"
        },
        {
          "name": "settings",
          "type": "Pipeline",
          "at": "/",
          "origins": [
            "databricks/pipeline"
          ],
          "when": "type(text) == map && !(has(text.resources) && type(text.resources) == map && has(text.resources.pipelines) && type(text.resources.pipelines) == map) && ((has(text.name) && type(text.name) == string && text.name != '') || has(text.libraries))",
          "attributes": {
            "name": {
              "key": "name",
              "read": "text",
              "empty": "refuse",
              "refusals": {
                "empty": "A pipeline needs a name."
              }
            },
            "catalog": {
              "key": "catalog",
              "read": "text",
              "empty": "remove",
              "absent": {
                "json": "refuse"
              },
              "refusals": {
                "absent": "The settings file has no \"catalog\" to rewrite."
              }
            },
            "schema": {
              "key": "schema",
              "read": "text",
              "empty": "remove",
              "absent": {
                "json": "refuse"
              },
              "secondary": {
                "key": "target"
              },
              "refusals": {
                "absent": "The settings file has no \"schema\" to rewrite."
              }
            },
            "channel": {
              "key": "channel",
              "read": "text",
              "empty": "remove",
              "absent": {
                "json": "refuse"
              },
              "refusals": {
                "absent": "The settings file has no \"channel\" to rewrite."
              }
            },
            "serverless": {
              "value": "type(text) == map && has(text.serverless) && type(text.serverless) == string && text.serverless.lowerAscii() == 'true'",
              "readOnly": true
            },
            "continuous": {
              "value": "type(text) == map && has(text.continuous) && type(text.continuous) == string && text.continuous.lowerAscii() == 'true'",
              "readOnly": true
            },
            "development": {
              "value": "type(text) == map && has(text.development) && type(text.development) == string && text.development.lowerAscii() == 'true'",
              "readOnly": true
            }
          }
        },
        {
          "name": "notebookLibrary",
          "type": "Library",
          "at": "/resources/pipelines/{pipeline}/libraries/*",
          "origins": [
            "databricks/pipeline"
          ],
          "when": "type(text) == map && size(text) == 1 && has(text.notebook) && type(text.notebook) == map",
          "attributes": {
            "libraryKind": {
              "value": "'notebook'"
            },
            "path": {
              "key": "path",
              "child": "notebook",
              "read": "text",
              "empty": "refuse",
              "refusals": {
                "empty": "A library needs a path."
              }
            }
          },
          "insert": {
            "place": "after-last",
            "container": "/resources/pipelines/{pipeline}/libraries",
            "when": "attributes.libraryKind == 'notebook'"
          },
          "remove": {
            "container": "keep"
          }
        },
        {
          "name": "fileLibrary",
          "type": "Library",
          "at": "/resources/pipelines/{pipeline}/libraries/*",
          "origins": [
            "databricks/pipeline"
          ],
          "when": "type(text) == map && size(text) == 1 && has(text.file) && type(text.file) == map",
          "attributes": {
            "libraryKind": {
              "value": "'file'"
            },
            "path": {
              "key": "path",
              "child": "file",
              "read": "text",
              "empty": "refuse",
              "refusals": {
                "empty": "A library needs a path."
              }
            }
          },
          "insert": {
            "place": "after-last",
            "container": "/resources/pipelines/{pipeline}/libraries",
            "when": "attributes.libraryKind == 'file'"
          },
          "remove": {
            "container": "keep"
          }
        },
        {
          "name": "globLibrary",
          "type": "Library",
          "at": "/resources/pipelines/{pipeline}/libraries/*",
          "origins": [
            "databricks/pipeline"
          ],
          "when": "type(text) == map && size(text) == 1 && has(text.glob) && type(text.glob) == map",
          "attributes": {
            "libraryKind": {
              "value": "'glob'"
            },
            "path": {
              "key": "include",
              "child": "glob",
              "read": "text",
              "readOnly": "A glob library is edited in the file."
            }
          },
          "remove": {
            "container": "keep"
          }
        },
        {
          "name": "otherLibrary",
          "type": "Library",
          "at": "/resources/pipelines/{pipeline}/libraries/*",
          "origins": [
            "databricks/pipeline"
          ],
          "when": "type(text) == map",
          "readOnly": "A library of this kind is edited in the file.",
          "attributes": {
            "libraryKind": {
              "value": "'other'"
            },
            "path": {
              "value": "type(text) == map && size(text) == 1 && type(text[text.map(k, k)[0]]) == map ? (has(text[text.map(k, k)[0]].path) && type(text[text.map(k, k)[0]].path) == string ? text[text.map(k, k)[0]].path : has(text[text.map(k, k)[0]].include) && type(text[text.map(k, k)[0]].include) == string ? text[text.map(k, k)[0]].include : '') : ''"
            }
          },
          "remove": {
            "container": "keep"
          }
        },
        {
          "name": "settingsLibrary",
          "type": "Library",
          "at": "/libraries/*",
          "origins": [
            "databricks/pipeline"
          ],
          "attributes": {
            "libraryKind": {
              "value": "type(text) == map && size(text) == 1 && type(text[text.map(k, k)[0]]) == map && text.map(k, k)[0] in ['notebook', 'file', 'glob'] ? text.map(k, k)[0] : 'other'",
              "readOnly": "The kind is which mapping the library entry carries."
            },
            "path": {
              "value": "type(text) == map && size(text) == 1 && type(text[text.map(k, k)[0]]) == map ? (has(text[text.map(k, k)[0]].path) && type(text[text.map(k, k)[0]].path) == string ? text[text.map(k, k)[0]].path : has(text[text.map(k, k)[0]].include) && type(text[text.map(k, k)[0]].include) == string ? text[text.map(k, k)[0]].include : '') : ''",
              "readOnly": "A library's path is changed by removing it and adding another."
            }
          },
          "remove": {
            "container": "keep"
          },
          "when": "type(text) == map"
        },
        {
          "name": "notification",
          "type": "Notification",
          "at": "/resources/pipelines/{pipeline}/notifications/*",
          "origins": [
            "databricks/pipeline"
          ],
          "when": "type(text) == map",
          "readOnly": "Notifications are edited in the file.",
          "attributes": {
            "recipients": {
              "value": "has(text.email_recipients) && type(text.email_recipients) == list ? text.email_recipients.filter(i, type(i) == string) : []"
            },
            "alerts": {
              "value": "has(text.alerts) && type(text.alerts) == list ? text.alerts.filter(i, type(i) == string) : []"
            }
          }
        },
        {
          "name": "settingsNotification",
          "type": "Notification",
          "at": "/notifications/*",
          "origins": [
            "databricks/pipeline"
          ],
          "when": "type(text) == map",
          "readOnly": "Notifications are edited in the file.",
          "attributes": {
            "recipients": {
              "value": "has(text.email_recipients) && type(text.email_recipients) == list ? text.email_recipients.filter(i, type(i) == string) : []"
            },
            "alerts": {
              "value": "has(text.alerts) && type(text.alerts) == list ? text.alerts.filter(i, type(i) == string) : []"
            }
          }
        },
        {
          "name": "dependency",
          "type": "Dependency",
          "at": "/resources/jobs/{job}/tasks/*/depends_on/*",
          "origins": [
            "databricks/job"
          ],
          "when": "type(text) == map && has(text.task_key) && type(text.task_key) == string && text.task_key != ''",
          "attributes": {
            "upstreamKey": {
              "key": "task_key",
              "read": "text",
              "readOnly": true
            },
            "outcome": {
              "key": "outcome",
              "read": "text",
              "empty": "remove"
            },
            "from": {
              "key": "task_key",
              "read": "text",
              "readOnly": true
            }
          },
          "parent": {
            "rules": [
              "task",
              "keylessTask"
            ]
          },
          "insert": {
            "place": "after-last",
            "container": "depends_on",
            "create": {
              "at": {
                "after": "task_key"
              }
            },
            "keys": [
              "task_key",
              "outcome"
            ]
          },
          "remove": {
            "container": "remove-when-empty"
          }
        }
      ],
      "relations": [],
      "template": {
        "text": "bundle:\r\n  name: {key:lower}\r\ntargets:\r\n  dev:\r\n    mode: development\r\n    default: true\r\n",
        "byOrigin": {
          "databricks/bundle": "bundle:\r\n  name: {key:lower}\r\ntargets:\r\n  dev:\r\n    mode: development\r\n    default: true\r\n",
          "databricks/job": "resources:\r\n  jobs:\r\n    {key:lower}:\r\n      name: {base}\r\n      tasks:\r\n        - task_key: main\r\n          notebook_task:\r\n            notebook_path: notebooks/{key:lower}\r\n",
          "databricks/pipeline": "{\r\n  \"name\": \"{key:lower}\",\r\n  \"libraries\": [\r\n    { \"notebook\": { \"path\": \"transformations/{key:lower}\" } }\r\n  ]\r\n}\r\n"
        },
        "doc": "The three new documents of the module's factory, one per reading, each keyed by the file's base name in lower case: My_Job.yml is the job my_job."
      }
    }
  }
}
