<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- xUnit v3 test projects are executables: the test host is the project itself. -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\EtAlii.Adp.Diagram.DependencyGraph\EtAlii.Adp.Diagram.DependencyGraph.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The round-trip corpus, beside the test binary so a test reads a document from disk exactly
      as the backend will. PreserveNewest rather than Always: a byte-for-byte round-trip test
      compares against the file it copied, so the copy must not be rewritten under a running test.
    -->
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <!--
      The binding and the definition's persistence as the requirements draft them (dependency-graph-disl-fbl,
      task 2): test resources, which the module does not read. The tests read each finding through them.
    -->
    <Content Include="Parity\Drafted\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
