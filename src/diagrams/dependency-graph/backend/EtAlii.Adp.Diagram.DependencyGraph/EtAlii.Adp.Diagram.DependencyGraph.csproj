<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <!--
      Core abstractions only. The dependency runs module -> core and never back: core must
      compile and test with this module absent, which is what the dependency-graph spec's
      "core learns nothing new" claim rests on.
    -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Backend\EtAlii.Adp.Backend.csproj" />
    <!-- The toolbox, the context menus and the property rows are derived from the bundled DISL definition. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reading only. See the note beside its PackageVersion in src/Directory.Packages.props. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- This type's own wire payload, packed into the core Element's Any. -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DISL definition bundled from etalii-adp/etalii.adp (src/diagrams/tools/bundle-disl.sh), and its provenance. -->
    <EmbeddedResource Include="..\..\definition\dependency-graph.dis" LogicalName="dependency-graph.dis" />
    <EmbeddedResource Include="..\..\definition\provenance.json" LogicalName="dependency-graph.provenance.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.DependencyGraph.Tests" />
  </ItemGroup>

</Project>
