<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <!--
      Core abstractions only, and the dependency runs module -> core and never back. Task 9 needed
      Documents alone, for the document itself. Task 11 adds Diagram, for the session, the shared diff
      and the shared change handler, and Context and Hierarchy for the selection resolver it lands
      with. Nothing here references EtAlii.Adp.Backend yet: the commands and providers that need it
      arrive with tasks 12 and 13, so a reader can still see from this file how much of the module
      exists.
    -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reading only. See the note beside its PackageVersion in src/Directory.Packages.props. -->
    <PackageReference Include="YamlDotNet" />
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- This type's own wire payload, packed into the core Element's Any. -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.FunctionalDecompositionGraph.Tests" />
  </ItemGroup>

</Project>
