<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Documents\EtAlii.Adp.Documents.csproj" />
    <!--
      Core abstractions only, and the dependency runs module -> core and never back. Task 9 needed
      Documents alone, for the document itself. Task 11 adds Diagram, for the session, the shared diff
      and the shared change handler, and Context and Hierarchy for the selection resolver it lands
      with. Task 12 adds History, for the commands and the shared restore command that is each one's
      undo. Nothing here references EtAlii.Adp.Backend yet: the providers that need it arrive with
      task 13, so a reader can still see from this file how much of the module exists.
    -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram\EtAlii.Adp.Diagram.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Diagram.Modules\EtAlii.Adp.Diagram.Modules.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.History\EtAlii.Adp.History.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Context\EtAlii.Adp.Context.csproj" />
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Hierarchy\EtAlii.Adp.Hierarchy.csproj" />
    <!-- The body is read through FBL: the binding below, applied by the library. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Fbl\EtAlii.Adp.Specification.Fbl.csproj" />
    <!-- The toolbox, the menus, the rows and the findings are derived from the bundled DISL definition. -->
    <ProjectReference Include="..\..\..\..\backend\EtAlii.Adp.Specification.Disl\EtAlii.Adp.Specification.Disl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FdgParser reads with it, for FdgWriter and the cross-check, until every edit is written by splices (functional-decomposition-graph-disl-fbl task 10). -->
    <PackageReference Include="YamlDotNet" />
    <!-- Google.Protobuf is the runtime; Grpc.Tools compiles the .proto below at build. -->
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- This type's own wire payload, packed into the core Element's Any. -->
    <Protobuf Include="..\..\api\*.proto" ProtoRoot="..\..\api" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <!-- The FBL binding of the .fdg body, loaded once by FdgBody. -->
    <EmbeddedResource Include="functional-decomposition-graph.fbl" LogicalName="functional-decomposition-graph.fbl" />
  </ItemGroup>

  <ItemGroup>
    <!-- The DISL definition bundled from etalii-adp/etalii.adp (src/diagrams/tools/bundle-disl.sh), and its provenance. -->
    <EmbeddedResource Include="..\..\definition\functional-decomposition-graph.dis" LogicalName="functional-decomposition-graph.dis" />
    <EmbeddedResource Include="..\..\definition\provenance.json" LogicalName="functional-decomposition-graph.provenance.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EtAlii.Adp.Diagram.FunctionalDecompositionGraph.Tests" />
  </ItemGroup>

</Project>
